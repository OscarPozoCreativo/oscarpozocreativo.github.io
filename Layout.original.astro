    .p-num { font-family: var(--font-display); font-size: 3rem; color: transparent; -webkit-text-stroke: 1px var(--border); display: block; margin-bottom: 20px; font-weight: 700; transition: all 0.3s; }
    .p-card:hover .p-num { -webkit-text-stroke: 1px var(--accent); color: rgba(64,181,229,0.1); }
    .p-title { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; }
