    .profile-main .t-title { font-size: clamp(1.5rem, 3vw, 2.2rem); margin-bottom: 30px; font-family: var(--font-display); text-transform: uppercase; }
    .profile-main p { color: var(--muted); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px; }
    .profile-sidebar .t-eyebrow { display: block; font-family: var(--font-display); font-size: 8px; color: var(--accent); text-transform: uppercase; letter-spacing: 2px; font-weight: 700; }
