        --modal-bg: rgba(244,244,245,0.95); --modal-panel: #ffffff;
        --nav-text: #050505; --nav-logo-filter: invert(1); --cta-bg: #050505; --cta-text: #ffffff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    /* CURSOR NATIVO RESTAURADO */
    body { background-color: var(--bg); color: var(--text); font-family: var(--font-body); overflow-x: hidden; min-height: calc(var(--op-vh, 1vh) * 100); overscroll-behavior-x: none; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; transition: background-color 0.5s, color 0.5s; cursor: auto; }
    html.op-webgl-fallback body::before { content: ''; position: fixed; inset: 0; z-index: -3; pointer-events: none; background: radial-gradient(circle at 18% 24%, rgba(255,255,255,0.055), transparent 26vw), radial-gradient(circle at 78% 18%, rgba(64,181,229,0.05), transparent 30vw), radial-gradient(circle at 50% 92%, rgba(255,255,255,0.035), transparent 32vw), #050505; }
    .elite-cursor { display: none !important; }

    ::-webkit-scrollbar { width: 0px; background: transparent; }
    ::selection { background: var(--accent); color: #fff; }
    *:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); border-radius: 4px; }
    html.op-loader-complete #system-init, html.op-clean-language-nav #system-init { display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; transform: translate3d(0,-100%,0) !important; }
    html.op-loader-active { cursor: progress; }
    
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
    #progress-bar { position: fixed; top: 0; left: 0; height: 3px; background: var(--accent); z-index: 1000000; width: 100%; pointer-events: none; transform: scaleX(0) translateZ(0); transform-origin: left center; will-change: transform; }
    :root { --op-nav-blur-height: clamp(62px, 8vh, 86px); --op-nav-blur-strength: 10px; }
    #op-nav-blur-shield { position: fixed; top: 0; left: 0; width: 100%; height: var(--op-nav-blur-height); z-index: 90; pointer-events: none; backdrop-filter: blur(var(--op-nav-blur-strength)); -webkit-backdrop-filter: blur(var(--op-nav-blur-strength)); background: linear-gradient(to bottom, rgba(2,2,2,0.30) 0%, rgba(2,2,2,0.14) 52%, rgba(2,2,2,0.02) 82%, rgba(2,2,2,0) 100%) !important; mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 68%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 68%, rgba(0,0,0,0) 100%); transform: translate3d(0,0,0); backface-visibility: hidden; will-change: opacity, transform; contain: paint; isolation: isolate; }
    html.op-nav-blur-refresh #op-nav-blur-shield { transform: translate3d(0,0.01px,0); }
    #liquid-refraction-canvas { position: fixed; left: 0; top: 0; width: 100vw; height: calc(var(--op-vh, 1vh) * 100); z-index: 99999; pointer-events: none; opacity: 0; mix-blend-mode: screen; contain: strict; transform: translate3d(0,0,0); will-change: opacity; }
    @media (pointer: coarse), (max-width: 859px), (prefers-reduced-motion: reduce) { #liquid-refraction-canvas { display: none !important; } }
    #webgl-canvas { height: calc(var(--op-vh, 1vh) * 100) !important; transform: translate3d(0,0,0); contain: strict; will-change: transform; }
    html.op-low-power .noise-overlay,
    html.op-perf-stress .noise-overlay { opacity: 0.02 !important; }

    #system-init { position: fixed; inset: 0; background: var(--bg); z-index: 999999; display: flex; align-items: center; justify-content: center; flex-direction: column; will-change: clip-path, opacity, visibility; clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%); }
    .loader-terminal { font-family: var(--font-mono); font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 30px; text-align: center; }
    .loader-pct { color: var(--accent); font-size: 24px; font-weight: 700; display: block; margin-top: 10px; font-variant-numeric: tabular-nums; }
    .has-reveal { opacity: 0; } 
    .reveal-wrap { overflow: visible !important; display: inline-block; vertical-align: top; position: relative; }
    .reveal-text { display: inline-block; transform: translateY(30px); opacity: 0; position: relative; z-index: 2; padding: 10px 20px; margin: -10px -20px; will-change: transform, opacity; }
    .glow-text { background: linear-gradient(270deg, var(--accent), #00d4ff, var(--accent)); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: flowPlasma 4s ease-in-out infinite alternate; text-shadow: 0 0 20px rgba(64,181,229,0.3), 0 0 40px rgba(0,119,182,0.2); transform: translateZ(0); }
    @keyframes flowPlasma { 0%{background-position:0% 50%} 100%{background-position:100% 50%} }
    
    nav { position: fixed; top: 0; width: 100%; padding: clamp(15px, 2vh, 20px) clamp(20px, 4vw, 40px); display: flex; justify-content: space-between; align-items: flex-start; z-index: 100; pointer-events: none; background: transparent !important; border: none !important; height: 100px; isolation: isolate; transform: translate3d(0,0,0); backface-visibility: hidden; overflow: visible; contain: layout style; }
    nav::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: var(--op-nav-blur-height); z-index: 0; pointer-events: none; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); background: linear-gradient(to bottom, rgba(2,2,2,0.18) 0%, rgba(2,2,2,0.08) 56%, rgba(2,2,2,0) 100%) !important; mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 66%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 66%, rgba(0,0,0,0) 100%); transform: translate3d(0,0,0); backface-visibility: hidden; will-change: opacity, transform; contain: paint; opacity: 0.42 !important; isolation: isolate; }
    nav > * { position: relative; z-index: 1; }
    .hud-left { display: flex; flex-direction: row; align-items: center; gap: 40px; pointer-events: auto; }
    .hud-logo { display: flex; align-items: center; background: transparent; padding: 0; font-family: var(--font-display); font-weight: 700; color: var(--nav-text); text-decoration: none; font-size: 1.5rem; }
    .hud-controls { display: flex; gap: 20px; align-items: center; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; height: 40px; }
    .ctrl-btn { background: transparent; border: none; color: var(--nav-text); padding: 0; transition: opacity 0.3s, color 0.3s; pointer-events: auto; font-weight: 700; letter-spacing: 1px; opacity: 0.7; cursor: pointer; text-decoration: none; }
    .ctrl-btn:hover, .ctrl-btn.active { opacity: 1; }
    .hud-right { display: flex; align-items: center; gap: 25px; pointer-events: auto; }
    .hud-status { text-align: right; font-family: var(--font-display); font-size: 8px; color: var(--nav-text); opacity: 0.7; line-height: 1.8; text-transform: uppercase; letter-spacing: 1px; background: transparent; padding: 0; border: none; transition: color 0.3s; }
    .hud-status strong { color: var(--nav-text); font-size: 10px; font-weight: 700; opacity: 1; }
    .btn-cta-nav { height: 38px; padding: 0 24px; background: var(--cta-bg); color: var(--cta-text); border-radius: 100px; font-family: var(--font-display); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: transform 0.3s, background 0.3s, color 0.3s, box-shadow 0.3s; pointer-events: auto; border: none; transform: translateZ(0); }
    .btn-cta-nav:hover { transform: scale(1.05) translateZ(0); }
    
    .z-wrapper, .reels-wrapper, .vault-wrapper, .process-wrapper, .profile-wrapper, .terminal-wrapper, .site-footer { background: transparent !important; position: relative; z-index: 10; }
    .z-wrapper { width: 100vw; height: 100vh; position: relative; overflow: hidden; pointer-events: none; }
    .z-layer { position: absolute; inset: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; transform: translate3d(0,0,0); backface-visibility: hidden; pointer-events: none; will-change: transform, filter, opacity; }
    .z-layer:not(.layer-hero) { visibility: hidden; opacity: 0; }
    .layer-hero { flex-direction: column; text-align: center; pointer-events: auto; position: relative; justify-content: center; margin-top: -5vh; }
    .hero-title { font-family: var(--font-display); font-size: clamp(2.5rem, 8vw, 9rem); font-weight: 700; line-height: 0.85; text-transform: uppercase; letter-spacing: -2px; margin-bottom: 20px; }
    .hero-desc { max-width: 650px; font-size: clamp(0.95rem, 1.2vw, 1.1rem); line-height: 1.6; color: rgba(255,255,255,0.7); font-weight: 400; padding: 0 20px;}
    .scroll-indicator { position: absolute; bottom: 8vh; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 12px; pointer-events: none; opacity: 0; }
    .scroll-line { width: 1px; height: 40px; background: rgba(255,255,255,0.1); position: relative; overflow: hidden; }
    .scroll-line::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 50%; background: var(--accent); animation: scrollDrop 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
    .scroll-indicator span { font-family: var(--font-display); font-size: 7px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 3px; }
    @keyframes scrollDrop { 0% { transform: translateY(-100%); } 100% { transform: translateY(200%); } }
    
    /* =========================================
       DISEÑO DE TARJETAS (TAMAÑO PERFECTO, SIN BORDES NEGROS)
       ========================================= */
    .monolith, .h-card { 
        --op-card-ratio: 16 / 9;
        --op-card-ratio-num: 1.777778;
        --op-card-max-w: 1200px;
        position: relative;
        width: min(92vw, 1200px, var(--op-card-max-w));
        height: auto;
        aspect-ratio: var(--op-card-ratio);
        background: transparent !important;
        border: 1px solid rgba(255,255,255,0.08); 
        border-radius: 16px; overflow: hidden; display: block; 
        box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1); 
        pointer-events: auto; transition: box-shadow 0.4s, border 0.4s, transform 0.4s; transform: translate3d(0,0,0); backface-visibility: hidden; 
        will-change: transform, opacity; cursor: pointer;
    }
    .monolith:hover, .h-card:hover { 
        box-shadow: 0 40px 80px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.2); 
        border-color: rgba(255,255,255,0.15); 
    }

    .op-scroll-life-target {
        --op-scroll-life-scale: 1;
        --op-scroll-life-y: 0px;
        --op-scroll-life-opacity: 1;
        transform-origin: 50% 50%;
        transition: box-shadow 0.4s ease, border 0.4s ease, border-color 0.4s ease !important;
        will-change: auto;
        backface-visibility: hidden;
    }

    .op-scroll-life-target.is-scroll-life-active { will-change: transform, opacity; }

    .monolith.op-scroll-life-target,
    .h-card.op-scroll-life-target,
    .v-item.op-scroll-life-target,
    .reel-item.op-scroll-life-target {
        opacity: 1;
        transform-origin: 50% 50%;
    }

    .monolith::before, .h-card::before {
        content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 60%; 
        background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 100%); 
        z-index: 2; pointer-events: none; transition: opacity 0.4s;
    }
    .monolith:hover::before, .h-card:hover::before { opacity: 0.7; }
    
    .m-img-wrap, .h-img-wrap { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; background: transparent !important; transform: translateZ(0); z-index: 1; border-radius: inherit; }
    
    /* IMAGEN RESPONSIVE REAL: llena el marco sin deformarse ni dejar barras negras. */
    .target-img, .h-img, .v-bg, .reel-bg { 
        position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center; 
        transform: translate3d(0,0,0); transition: filter 0.8s cubic-bezier(0.19, 1, 0.22, 1); 
        filter: grayscale(0.3) brightness(0.8); backface-visibility: hidden; will-change: transform; 
        border-radius: inherit; background: transparent !important; display: block;
    }
    @media (min-width: 768px) and (hover: hover) and (pointer: fine) { .monolith:hover .target-img, .h-card:hover .target-img, .v-item:hover .v-bg, .reel-item:hover .target-img { filter: grayscale(0) brightness(1); } }
    
    .m-content, .h-info { 
        position: absolute; bottom: 30px; left: 30px; width: calc(100% - 60px);
        padding: 0; display: flex; flex-direction: column; justify-content: flex-end; 
        z-index: 3; pointer-events: none;
    }
    
    .m-meta span, .h-info .m-meta span { 
        font-family: var(--font-display); font-weight: 700; font-size: 10px; 
        color: var(--accent); text-transform: uppercase; letter-spacing: 1px;
        background: transparent; border: none; padding: 0; margin-bottom: 8px; display: inline-block; 
    }
    .m-meta span:nth-child(2), .h-info .m-meta span:nth-child(2) { display: none; } 

    .m-title, .h-info h3 { 
        font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.8rem); line-height: 1.2; 
        margin: 0; font-weight: 700; text-transform: uppercase; color: #fff; text-shadow: none;
    }
    
    .h-wrapper { width: 100vw; height: 100vh; overflow: hidden; position: relative; z-index: 10; perspective: 2500px; pointer-events: none; background: transparent !important; }
    .h-container { display: flex; width: 600vw; height: 100vh; transform-style: preserve-3d; will-change: transform;}
    .h-panel { width: 100vw; height: 100vh; display: flex; align-items: center; justify-content: center; padding: clamp(20px, 4vw, 60px); perspective: 2500px; transform-style: preserve-3d; pointer-events: none;}
    
    .reels-wrapper { min-height: 100vh; height: auto; display: flex; flex-direction: column; justify-content: center; padding: 12vh 0 12vh 5vw; border-top: 1px solid var(--border); overflow: hidden; perspective: 2000px; }
    .reels-wrapper .section-header { text-align: left; margin-bottom: 4vh; padding-right: 5vw; }
    .reels-track { display: flex; gap: clamp(20px, 3vw, 40px); padding: 0 5vw 40px 0; pointer-events: auto; width: max-content; will-change: transform; align-items: center; }
    .reel-item { flex: 0 0 auto; height: clamp(350px, 60vh, 550px); width: auto; aspect-ratio: 9/16; border-radius: 24px; position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: #050505; cursor: pointer; transform-style: preserve-3d; box-shadow: 0 20px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1); transition: border-color 0.4s, box-shadow 0.4s; will-change: transform, opacity; }
    .reel-item:hover { border-color: var(--accent); box-shadow: 0 40px 80px rgba(0,0,0,0.8), 0 0 40px rgba(64,181,229,0.3), inset 0 1px 0 rgba(255,255,255,0.3); z-index: 20; }
    .reel-glare { position: absolute; top: 0; left: 0; width: 200%; height: 200%; background: radial-gradient(circle at center, rgba(255,255,255,0.2) 0%, transparent 50%); mix-blend-mode: overlay; opacity: 0; pointer-events: none; z-index: 4; transform: translate(-50%, -50%); }
    .reel-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.2) 40%, transparent 100%); pointer-events: none; z-index: 2; transition: opacity 0.4s; }
    .reel-item:hover .reel-overlay { opacity: 0.6; }
    .reel-info { position: absolute; bottom: 25px; left: 25px; right: 25px; z-index: 3; pointer-events: none; transform: translateZ(30px); }
    .reel-info h4 { font-family: var(--font-display); font-size: clamp(0.9rem, 1.2vw, 1.1rem); font-weight: 700; text-transform: uppercase; line-height: 1.3; color: #fff; margin-bottom: 8px; text-shadow: 0 2px 10px rgba(0,0,0,0.8);}
    .reel-info span { font-family: var(--font-display); font-weight: 700; font-size: 8px; color: var(--accent); text-transform: uppercase; letter-spacing: 1px; }
    .video-badge { position: absolute; top: 20px; right: 20px; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 6px 12px; display: flex; align-items: center; gap: 6px; z-index: 5; pointer-events: none; transform: translateZ(20px); }
    .video-badge svg { width: 10px; height: 10px; fill: var(--accent); }
    .video-badge span { font-family: var(--font-display); font-size: 7px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 1px; }
    .target-img, .reel-bg { z-index: 1; }

    /* Tablet, iPad y laptop: misma navegación de escritorio, con medios completos sin recortes */
    @media (min-width: 768px) {
        .target-img, .h-img, .v-bg, .reel-bg, .hover-video {
            object-fit: cover !important;
            object-position: center center !important;
        }

        .m-title, .h-info h3, .v-info h4, .reel-info h4 {
            overflow-wrap: anywhere;
            text-wrap: balance;
        }
    }

    @media (min-width: 768px) and (max-width: 1180px) {
        nav {
            padding: clamp(15px, 2vh, 20px) clamp(18px, 3vw, 32px) !important;
            height: 96px !important;
            min-height: 0 !important;
            align-items: flex-start !important;
        }

        .hud-left { gap: clamp(18px, 3vw, 34px) !important; }
        .hud-controls { gap: clamp(12px, 2vw, 20px) !important; font-size: clamp(9px, 1.2vw, 11px) !important; }
        .hud-status { display: block !important; max-width: 190px; font-size: 7px; }
        .hud-status strong { font-size: 9px; }
        .btn-cta-nav { height: 36px; padding: 0 clamp(14px, 2.2vw, 22px); font-size: 8px; }

        .monolith, .h-card {
            width: min(88vw, 1080px, var(--op-card-max-w, 1080px));
            height: auto;
            aspect-ratio: var(--op-card-ratio, 16 / 9);
        }

        .m-content, .h-info {
            bottom: clamp(22px, 3vw, 30px);
            left: clamp(22px, 3vw, 30px);
            width: calc(100% - clamp(44px, 6vw, 60px));
        }

        .m-title, .h-info h3 {
            font-size: clamp(1.05rem, 2vw, 1.7rem);
            line-height: 1.18;
        }

        .lightbox__image-wrapper { width: 62vw; padding: clamp(24px, 3vw, 40px); }
        .lightbox__info { width: 38vw; padding: clamp(28px, 4vw, 40px) clamp(5vw, 7vw, 8vw) clamp(28px, 4vw, 40px) 0; }
        .lightbox__info h3 { font-size: clamp(1.25rem, 3vw, 2.1rem); }
        .lightbox__info .project-details { font-size: clamp(0.95rem, 1.35vw, 1.05rem); line-height: 1.55; }
    }

    /* Respira premium en laptop, iPad y pantallas intermedias.
       No altera móvil: empieza desde 768px. */
    @media (min-width: 768px) and (max-width: 1680px), (min-width: 768px) and (max-height: 980px) {
        .monolith, .h-card {
            width: min(64vw, 980px, var(--op-card-max-w, 980px));
            max-width: 980px;
        }

        .h-panel {
            padding: clamp(36px, 6vw, 96px);
        }

        .m-content, .h-info {
            bottom: clamp(20px, 2.6vw, 28px);
            left: clamp(20px, 2.6vw, 28px);
            width: calc(100% - clamp(40px, 5.2vw, 56px));
        }

        .m-title, .h-info h3 {
            font-size: clamp(1rem, 1.65vw, 1.45rem);
        }

        .reels-wrapper {
            padding-top: clamp(90px, 13vh, 130px);
            padding-bottom: clamp(90px, 13vh, 130px);
        }

        .reel-item {
            height: clamp(320px, 46vh, 460px);
        }
    }
    .hover-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 2; opacity: 0; pointer-events: none; transform: scale(1.05); transition: transform 0.5s; }
    .reel-item:hover .hover-video { transform: scale(1); }
    
    .vault-wrapper, .process-wrapper, .profile-wrapper, .terminal-wrapper { padding: clamp(60px, 8vh, 100px) 5vw; border-top: 1px solid var(--border); }
    .vault-grid, .process-grid, .profile-grid, .terminal-grid { gap: clamp(20px, 3vw, 40px); max-width: 1400px; margin: 0 auto; }
    .section-header { text-align: center; margin-bottom: 60px; }
    .section-header h2 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); text-transform: uppercase; }
    .vault-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
    .v-item { position: relative; height: 280px; border-radius: 12px; overflow: hidden; pointer-events: auto; border: 1px solid var(--border); transition: border 0.5s; transform: translate3d(0,0,0); backface-visibility: hidden; will-change: transform, opacity; cursor: pointer;}
    .v-item::before { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 60%; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%); z-index: 2; pointer-events: none; transition: opacity 0.4s; }
    .v-item:hover::before { opacity: 0.7; }
    .v-info { position: absolute; bottom: 20px; left: 20px; z-index: 3; pointer-events: none;}
    .v-info h4 { font-family: var(--font-display); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-bottom: 6px; line-height: 1.3; color: #fff;}
    .v-info span { font-family: var(--font-display); font-weight: 700; font-size: 8px; color: var(--accent); text-transform: uppercase; letter-spacing: 1px; }
    .process-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    
    .p-card, .profile-sidebar, .t-panel { 
        padding: 40px; 
