---
// src/layouts/Layout.astro
import { ClientRouter } from 'astro:transitions';
import HeadSEO from '../components/Core/HeadSEO.astro';
import Navigation from '../components/UI/Navigation.astro';
import Footer from '../components/UI/Footer.astro';
import Lightbox from '../components/UI/Lightbox.astro';

// --- SISTEMA DE MICRO-FRONTENDS ---
import GlobalState from '../components/System/GlobalState.astro';
import ScrollEngine from '../components/System/ScrollEngine.astro';
import PreloaderLogic from '../components/System/PreloaderLogic.astro';
import NavigationLogic from '../components/System/NavigationLogic.astro';
import MediaOptimizer from '../components/System/MediaOptimizer.astro';
import ScrollGravity from '../components/System/ScrollGravity.astro';
import LightboxLogic from '../components/System/LightboxLogic.astro';

// Motores Pesados (WebGL y Audio)
import ParticlesBackground from '../components/WebGL/ParticlesBackground.astro';
import LiquidCursor from '../components/WebGL/LiquidCursor.astro';
import AudioEngine from '../components/System/AudioEngine.astro';

import '../styles/global.css';

interface Props { title: string; description: string; lang: string; }
const { title, description, lang } = Astro.props;
const currentPath = Astro.url?.pathname || '/';
const isEnglish = String(lang || '').toLowerCase().startsWith('en') || currentPath.startsWith('/en');
const effectiveLang = isEnglish ? 'en' : 'es';

const lbCloseLabel = isEnglish ? 'CLOSE' : 'CERRAR';
const lbPrevLabel = isEnglish ? 'PREVIOUS' : 'ANTERIOR';
const lbNextLabel = isEnglish ? 'NEXT' : 'SIGUIENTE';
const lbViewTitle = isEnglish ? 'Project view' : 'Vista del proyecto';
---

<!doctype html>
<html lang={effectiveLang} data-theme="dark">
	<head>
		<HeadSEO title={title} description={description} lang={effectiveLang} />
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<Navigation />
		<main><slot /></main>
		<Footer />
		<Lightbox lbCloseLabel={lbCloseLabel} lbPrevLabel={lbPrevLabel} lbNextLabel={lbNextLabel} lbViewTitle={lbViewTitle} />

		<!-- ORDEN DE EJECUCIÓN ESTRICTO -->
		<GlobalState />
		<ScrollEngine />
		<PreloaderLogic />
		<NavigationLogic />
		<MediaOptimizer />
		<ScrollGravity />
		<LightboxLogic />
		
		<ParticlesBackground />
		<LiquidCursor />
		<AudioEngine />
	</body>
</html>