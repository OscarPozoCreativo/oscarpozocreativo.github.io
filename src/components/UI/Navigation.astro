---
interface NavData {
    langUrl: string;
    langText: string;
    role: string;
    loc: string;
    cta: string;
}

interface Props {
    nav: NavData;
    lang?: string;
}

const { nav, lang = 'es' } = Astro.props;
const isEnglish = String(lang).toLowerCase().startsWith('en');
const homeLabel = isEnglish ? 'Home' : 'Inicio';
---

<nav id="main-nav">
    <div class="hud-left">
        <a href="#" class="hud-logo hover-target magnetic-target" tabindex="0" aria-label={homeLabel}>
            <img
                src="/favicon-light.png"
                alt="Oscar Pozo Logo"
                class="hud-logo__image"
                loading="eager"
                decoding="async"
            />
        </a>
        <div class="hud-controls">
            <a href={nav.langUrl} class="ctrl-btn hover-target magnetic-target" tabindex="0">{nav.langText}</a>
            <button class="ctrl-btn hover-target active magnetic-target" id="btn-audio" tabindex="0">SFX: ON</button>
        </div>
    </div>
    <div class="hud-right">
        <div class="hud-status"><strong>{nav.role}</strong><br /><span>{nav.loc}</span></div>
        <a href="#contacto" class="btn-cta-nav magnetic-target hover-target">{nav.cta}</a>
    </div>
</nav>

<style>
nav {
    position: fixed;
    top: 0;
    width: 100%;
    padding: clamp(15px, 2vh, 20px) clamp(20px, 4vw, 40px);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 100;
    pointer-events: none;
    background: transparent !important;
    border: none !important;
    height: 100px;
    isolation: isolate;
    transform: translate3d(0,0,0);
    backface-visibility: hidden;
    overflow: visible;
    contain: layout style;
}

nav::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--op-nav-blur-height);
    z-index: 0;
    pointer-events: none;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: linear-gradient(to bottom, rgba(2,2,2,0.18) 0%, rgba(2,2,2,0.08) 56%, rgba(2,2,2,0) 100%) !important;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 66%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 66%, rgba(0,0,0,0) 100%);
    transform: translate3d(0,0,0);
    backface-visibility: hidden;
    will-change: opacity, transform;
    contain: paint;
    opacity: 0.42 !important;
    isolation: isolate;
}

nav > * {
    position: relative;
    z-index: 1;
}

.hud-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 40px;
    pointer-events: auto;
}

.hud-logo {
    display: flex;
    align-items: center;
    background: transparent;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--nav-text);
    text-decoration: none;
    font-size: 1.5rem;
}

.hud-logo__image {
    width: 35px;
    height: 35px;
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), filter 0.3s;
    filter: var(--nav-logo-filter);
    transform: translateZ(0);
    will-change: transform;
}

.hud-controls {
    display: flex;
    gap: 20px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    height: 40px;
}

.ctrl-btn {
    background: transparent;
    border: none;
    color: var(--nav-text);
    padding: 0;
    transition: opacity 0.3s, color 0.3s;
    pointer-events: auto;
    font-weight: 700;
    letter-spacing: 1px;
    opacity: 0.7;
    cursor: pointer;
    text-decoration: none;
}

.ctrl-btn:hover,
.ctrl-btn.active {
    opacity: 1;
}

.hud-right {
    display: flex;
    align-items: center;
    gap: 25px;
    pointer-events: auto;
}

.hud-status {
    text-align: right;
    font-family: var(--font-display);
    font-size: 8px;
    color: var(--nav-text);
    opacity: 0.7;
    line-height: 1.8;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: transparent;
    padding: 0;
    border: none;
    transition: color 0.3s;
}

.hud-status strong {
    color: var(--nav-text);
    font-size: 10px;
    font-weight: 700;
    opacity: 1;
}

.btn-cta-nav {
    height: 38px;
    padding: 0 24px;
    background: var(--cta-bg);
    color: var(--cta-text);
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.3s, background 0.3s, color 0.3s, box-shadow 0.3s;
    pointer-events: auto;
    border: none;
    transform: translateZ(0);
}

.btn-cta-nav:hover {
    transform: scale(1.05) translateZ(0);
}

@media (min-width: 768px) and (max-width: 1180px) {
    nav {
        padding: clamp(15px, 2vh, 20px) clamp(18px, 3vw, 32px) !important;
        height: 96px !important;
        min-height: 0 !important;
        align-items: flex-start !important;
    }

    .hud-left { gap: clamp(18px, 3vw, 34px) !important; }
    .hud-controls { gap: clamp(12px, 2vw, 20px) !important; font-size: clamp(9px, 1.2vw, 11px) !important; }
    .hud-status { display: block !important; max-width: 190px; font-size: 7px; }
    .hud-status strong { font-size: 9px; }
    .btn-cta-nav { height: 36px; padding: 0 clamp(14px, 2.2vw, 22px); font-size: 8px; }
}

@media (max-width: 767px), (max-height: 560px) and (pointer: coarse) {
    .hud-status { display: none; }
    nav { padding: 15px 20px !important; height: auto !important; min-height: 80px !important; }
    .btn-cta-nav { padding: 0 16px !important; font-size: 8px !important; }
}

@media (max-width: 1024px), (pointer: coarse) {
    :global(html.op-mobile-perf) nav::before,
    :global(html.op-mobile-perf #op-nav-blur-shield) {
        height: clamp(56px, 7.5vh, 76px) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        background: linear-gradient(to bottom, rgba(2,2,2,0.62) 0%, rgba(2,2,2,0.16) 58%, rgba(2,2,2,0) 100%) !important;
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 64%, rgba(0,0,0,0) 100%) !important;
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 64%, rgba(0,0,0,0) 100%) !important;
        transform: translate3d(0,0,0) !important;
    }

    :global(html.op-mobile-perf) nav::before { opacity: 0.36 !important; }
}

@media (max-width: 767px) {
    nav::before,
    :global(#op-nav-blur-shield) {
        height: clamp(56px, 7.5vh, 76px);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transform: translate3d(0,0,0);
    }
}

@media (max-width: 420px) {
    .hud-left { gap: 18px !important; }
    .hud-controls { gap: 12px !important; font-size: 10px !important; }
    .btn-cta-nav { padding: 0 12px !important; }
}
</style>
