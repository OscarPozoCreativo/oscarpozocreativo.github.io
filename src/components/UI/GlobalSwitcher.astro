---
// src/components/UI/GlobalSwitcher.astro
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const isPhoto = currentPath.includes('/photo');

const designUrl = isEnglish ? '/en/' : '/';
const photoUrl = isEnglish ? '/en/photo' : '/photo';

const designText = isEnglish ? 'Design' : 'Diseño';
const photoText = isEnglish ? 'Photography' : 'Fotografía';
---

<div class="switcher-text-only gpu-layer" style="pointer-events: auto;">
    <!-- ENLACE DISEÑO (Hereda la clase ctrl-btn nativa) -->
    <a href={designUrl} class={`ctrl-btn switch-link hover-target ${!isPhoto ? 'active' : ''}`}>
        {designText}
    </a>
    
    <!-- DIVISOR CON OPACIDAD DE DISEÑO -->
    <span class="switcher-divider">/</span>
    
    <!-- ENLACE FOTOGRAFÍA (Hereda la clase ctrl-btn nativa) -->
    <a href={photoUrl} class={`ctrl-btn switch-link hover-target ${isPhoto ? 'active' : ''}`}>
        {photoText}
    </a>
</div>

<style>
    .switcher-text-only {
        display: flex;
        align-items: center;
        gap: 15px; /* Mismo gap simétrico que el selector de idiomas de la derecha */
        flex-shrink: 0;
    }

    /* Forzamos la herencia y agregamos transiciones suaves */
    .switch-link {
        text-decoration: none;
        transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer !important; /* MODIFICADO: Puntero nativo visible */
    }

    /* TU AZUL DE FIRMA PREMIUM CON EFECTO DE GLOW / PLASMA */
    .switch-link.active {
        color: #40B5E5 !important;
        opacity: 1 !important;
        text-shadow: 0 0 15px rgba(64, 181, 229, 0.45) !important; /* Brillo premium sutil */
    }

    .switcher-divider {
        font-family: var(--font-mono, monospace);
        font-size: 11px;
        color: #ffffff;
        opacity: 0.15; /* Sintonizado con la barra divisora de ES / EN */
        user-select: none;
    }

    @media (max-width: 1024px) {
        .switcher-text-only {
            gap: 8px; /* Gap compacto para móvil */
        }
        .switcher-divider {
            font-size: 9px;
        }
    }
</style>