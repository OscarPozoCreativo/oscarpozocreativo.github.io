---
import ProjectCard from './ProjectCard.astro';

interface ProjectData {
    title: string;
    img: string;
    meta1: string;
    meta2: string;
    summary: string;
    reto: string;
    enfoque: string;
    resultado: string;
}

interface Props {
    projects: ProjectData[];
}

const { projects } = Astro.props;
const panelCount = Math.max(projects.length, 1);
---

<section class="h-wrapper" id="casos">
    <div class="h-container" style={`--h-panels: ${panelCount};`}>
        {projects.map((project) => (
            <div class="h-panel">
                <ProjectCard project={project} variant="horizontal" />
            </div>
        ))}
    </div>
</section>

<style>
.h-wrapper {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    position: relative;
    z-index: 10;
    perspective: 2500px;
    pointer-events: none;
    background: transparent !important;
}

.h-container {
    display: flex;
    width: calc(var(--h-panels, 1) * 100vw);
    height: 100vh;
    transform-style: preserve-3d;
    will-change: transform;
}

.h-panel {
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 60px);
    perspective: 2500px;
    transform-style: preserve-3d;
    pointer-events: none;
}

@media (min-width: 768px) and (max-width: 1680px), (min-width: 768px) and (max-height: 980px) {
    .h-panel {
        padding: clamp(36px, 6vw, 96px);
    }
}

@media (max-width: 767px), (max-height: 560px) and (pointer: coarse) {
    .h-wrapper {
        height: auto !important;
        overflow: visible !important;
        padding: 0 15px 40px !important;
        pointer-events: auto !important;
        background: transparent !important;
        color: #fff !important;
        perspective: none !important;
    }

    .h-container {
        width: 100% !important;
        height: auto !important;
        flex-direction: column !important;
        gap: 40px !important;
        transform: none !important;
        display: flex !important;
    }

    .h-panel {
        width: 100% !important;
        height: auto !important;
        padding: 0 !important;
        transform: none !important;
        display: block !important;
        perspective: none !important;
    }
}

@media (max-width: 1024px), (pointer: coarse) {
    :global(html.op-mobile-perf) .h-container,
    :global(html.op-mobile-perf) .h-panel {
        will-change: auto !important;
        backface-visibility: visible !important;
    }

    :global(html.op-mobile-perf) .h-wrapper {
        content-visibility: visible !important;
        contain-intrinsic-size: auto !important;
    }
}

@media (max-width: 767px) {
    :global(html.op-mobile-perf) .h-wrapper,
    :global(html.op-mobile-perf) .h-container,
    :global(html.op-mobile-perf) .h-panel {
        perspective: none !important;
        transform-style: flat !important;
        will-change: auto !important;
        backface-visibility: visible !important;
    }

    :global(html.op-mobile-perf) .h-wrapper {
        display: block !important;
        overflow: visible !important;
        contain: none !important;
    }

    :global(html.op-mobile-perf) .h-container {
        display: flex !important;
        flex-direction: column !important;
        gap: 40px !important;
        width: 100% !important;
        height: auto !important;
        transform: none !important;
        contain: none !important;
    }

    :global(html.op-mobile-perf) .h-panel {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        height: auto !important;
        padding: 0 !important;
        margin: 0 !important;
        transform: none !important;
        perspective: none !important;
        contain: layout paint style !important;
        isolation: isolate !important;
    }
}
</style>
