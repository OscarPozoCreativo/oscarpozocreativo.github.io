---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';

interface ReelData {
    title: string;
    thumb: string;
    videoFull: string;
    videoHover: string;
    meta: string;
    summary: string;
}

interface Props {
    title: string;
    reels: ReelData[];
}

const { title, reels } = Astro.props;
---

<section class="reels-wrapper" id="audiovisual">
    <div class="section-header"><h2 class="has-reveal">{title}</h2></div>
    <div class="reels-track">
        {reels.map((reel) => (
            <article
                class="reel-item hover-target lb-trigger"
                tabindex="0"
                role="button"
                aria-label="Abrir proyecto"
                data-title={reel.title}
                data-video-full={reel.videoFull}
            >
                <Image src={resolveImage(reel.thumb)} alt={reel.title} class="reel-bg target-img" width={400} height={700} />
                <video class="hover-video" src={reel.videoHover} muted loop playsinline preload="none"></video>
                <div class="reel-overlay"></div>
                <div class="reel-glare"></div>
                <div class="video-badge"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg><span>Play</span></div>
                <div class="reel-info"><span>{reel.meta}</span><h4>{reel.title}</h4></div>
                <div class="project-details" style="display:none;"><p class="m-summary">{reel.summary}</p></div>
            </article>
        ))}
    </div>
</section>

<style>
.reels-wrapper {
    background: transparent !important;
    position: relative;
    z-index: 10;
    min-height: 100vh;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 12vh 0 12vh 5vw;
    border-top: 1px solid var(--border);
    overflow: hidden;
    perspective: 2000px;
}

.section-header {
    text-align: left;
    margin-bottom: 4vh;
    padding-right: 5vw;
}

.section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
}

.has-reveal {
    opacity: 0;
}

.reels-track {
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    padding: 0 5vw 40px 0;
    pointer-events: auto;
    width: max-content;
    will-change: transform;
    align-items: center;
}

.reel-item {
    flex: 0 0 auto;
    height: clamp(350px, 60vh, 550px);
    width: auto;
    aspect-ratio: 9/16;
    border-radius: 24px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: #050505;
    cursor: pointer;
    transform-style: preserve-3d;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1);
    transition: border-color 0.4s, box-shadow 0.4s;
    will-change: transform, opacity;
}

.reel-item:hover {
    border-color: var(--accent);
    box-shadow: 0 40px 80px rgba(0,0,0,0.8), 0 0 40px rgba(64,181,229,0.3), inset 0 1px 0 rgba(255,255,255,0.3);
    z-index: 20;
}

.reel-glare {
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(255,255,255,0.2) 0%, transparent 50%);
    mix-blend-mode: overlay;
    opacity: 0;
    pointer-events: none;
    z-index: 4;
    transform: translate(-50%, -50%);
}

.reel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.2) 40%, transparent 100%);
    pointer-events: none;
    z-index: 2;
    transition: opacity 0.4s;
}

.reel-item:hover .reel-overlay {
    opacity: 0.6;
}

.reel-info {
    position: absolute;
    bottom: 25px;
    left: 25px;
    right: 25px;
    z-index: 3;
    pointer-events: none;
    transform: translateZ(30px);
}

.reel-info h4 {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.3;
    color: #fff;
    margin-bottom: 8px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
}

.reel-info span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 8px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.video-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 100px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 5;
    pointer-events: none;
    transform: translateZ(20px);
}

.video-badge svg {
    width: 10px;
    height: 10px;
    fill: var(--accent);
}

.video-badge span {
    font-family: var(--font-display);
    font-size: 7px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
}

:global(.reel-bg),
:global(.target-img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: translate3d(0,0,0);
    transition: filter 0.8s cubic-bezier(0.19, 1, 0.22, 1);
    filter: grayscale(0.3) brightness(0.8);
    backface-visibility: hidden;
    will-change: transform;
    border-radius: inherit;
    background: transparent !important;
    display: block;
    z-index: 1;
}

.hover-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transform: scale(1.05);
    transition: transform 0.5s;
}

.reel-item:hover .hover-video {
    transform: scale(1);
}

@media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .reel-item:hover :global(.target-img) {
        filter: grayscale(0) brightness(1);
    }
}

@media (min-width: 768px) {
    :global(.reel-bg),
    .hover-video {
        object-fit: cover !important;
        object-position: center center !important;
    }

    .reel-info h4 {
        overflow-wrap: anywhere;
        text-wrap: balance;
    }
}

@media (min-width: 768px) and (max-width: 1680px), (min-width: 768px) and (max-height: 980px) {
    .reels-wrapper {
        padding-top: clamp(90px, 13vh, 130px);
        padding-bottom: clamp(90px, 13vh, 130px);
    }

    .reel-item {
        height: clamp(320px, 46vh, 460px);
    }
}

@media (max-width: 767px), (max-height: 560px) and (pointer: coarse) {
    .reels-wrapper {
        padding: 80px 0 80px 15px !important;
        height: auto !important;
        perspective: none !important;
    }

    .reels-track {
        padding: 10px 15px 30px 0 !important;
        gap: 15px !important;
        overflow-x: auto !important;
        width: auto !important;
        scroll-snap-type: x mandatory !important;
        transform: none !important;
    }

    .reel-item {
        width: 80vw !important;
        max-width: 320px !important;
        border-radius: 16px !important;
        scroll-snap-align: center !important;
        transform: none !important;
    }
}

@media (max-width: 1024px), (pointer: coarse) {
    :global(html.op-mobile-perf) .video-badge {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
    }

    :global(html.op-mobile-perf) .reel-item,
    :global(html.op-mobile-perf .reel-bg),
    :global(html.op-mobile-perf .target-img) {
        will-change: auto !important;
        backface-visibility: visible !important;
    }

    :global(html.op-mobile-perf .reel-bg),
    :global(html.op-mobile-perf .target-img) {
        filter: none !important;
        transition: none !important;
        will-change: auto !important;
        transform: translate3d(0,0,0) !important;
    }

    :global(html.op-mobile-perf) .reel-item {
        contain: layout paint style;
        isolation: isolate;
        box-shadow: 0 14px 34px rgba(0,0,0,0.38), inset 0 1px 0 rgba(255,255,255,0.08) !important;
        transition: border-color 0.25s ease !important;
    }
}

@media (max-width: 767px) {
    :global(html.op-mobile-perf) .reels-wrapper {
        overflow: hidden !important;
        contain: layout paint style !important;
        content-visibility: visible !important;
        contain-intrinsic-size: auto !important;
    }

    :global(html.op-mobile-perf) .reels-track {
        contain: layout paint style !important;
        will-change: auto !important;
        transform: none !important;
        -webkit-overflow-scrolling: touch !important;
        overscroll-behavior-x: contain !important;
        content-visibility: visible !important;
        contain-intrinsic-size: auto !important;
    }

    :global(html.op-mobile-perf) .reel-item,
    :global(html.op-mobile-perf .op-mobile-video-card) {
        contain: layout paint style !important;
        isolation: isolate !important;
        transform-origin: 50% 50% !important;
        box-shadow: 0 12px 28px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.08) !important;
        transition: border-color 0.25s ease !important;
        backface-visibility: hidden !important;
        -webkit-backface-visibility: hidden !important;
        transform-style: flat !important;
        perspective: none !important;
    }

    :global(html.op-mobile-perf .reel-bg),
    :global(html.op-mobile-perf) .reel-item img {
        opacity: 1 !important;
        filter: none !important;
        transition: none !important;
        transform: translateZ(0) !important;
        will-change: auto !important;
        backface-visibility: hidden !important;
        image-rendering: auto;
    }

    :global(html.op-mobile-perf) .reel-overlay {
        transition: none !important;
        background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.15) 48%, transparent 100%) !important;
    }

    :global(html.op-mobile-perf) .reel-glare,
    :global(html.op-mobile-perf) .hover-video,
    :global(html.op-mobile-perf) video.hover-video,
    :global(html.op-mobile-perf) .reel-item video {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }

    :global(html.op-mobile-perf) .reel-item * {
        -webkit-tap-highlight-color: transparent;
    }
}

@media (max-width: 420px) {
    .reel-item {
        width: 82vw !important;
    }
}
</style>
