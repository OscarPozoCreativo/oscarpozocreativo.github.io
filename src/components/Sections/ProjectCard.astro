---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';

type Variant = 'z' | 'horizontal';

interface ProjectData {
    title: string;
    img: string;
    meta1: string;
    meta2: string;
    summary: string;
    reto: string;
    enfoque: string;
    resultado: string;
}

interface Props {
    project: ProjectData;
    variant?: Variant;
}

const { project, variant = 'z' } = Astro.props;
const isHorizontal = variant === 'horizontal';
const ArticleTag = 'article';
const TitleTag = isHorizontal ? 'h3' : 'h2';
const articleClass = isHorizontal
    ? 'h-card hover-target lb-trigger tilt-target skew-target'
    : 'monolith hover-target lb-trigger tilt-target skew-target';
const imageWrapClass = isHorizontal ? 'h-img-wrap' : 'm-img-wrap';
const imageClass = isHorizontal ? 'h-img target-img parallax-img' : 'm-img target-img';
const contentClass = isHorizontal ? 'h-info' : 'm-content';
---

<ArticleTag class={articleClass} tabindex="0" role="button" aria-label="Abrir proyecto" data-title={project.title}>
    {isHorizontal && <div class="card-glare"></div>}
    <div class={imageWrapClass}>
        <Image
            src={resolveImage(project.img)}
            alt={project.title}
            class={imageClass}
            width={isHorizontal ? 600 : 800}
            height={isHorizontal ? 400 : 600}
        />
    </div>
    <div class={contentClass}>
        <div class="m-meta"><span>{project.meta1}</span><span>{project.meta2}</span></div>
        <TitleTag class={isHorizontal ? undefined : 'm-title'}>{project.title}</TitleTag>
        <div class="project-details" style="display:none;">
            <p class="m-summary">{project.summary}</p>
            <div class="m-item"><strong>Reto</strong><p>{project.reto}</p></div>
            <div class="m-item"><strong>Enfoque</strong><p>{project.enfoque}</p></div>
            <div class="m-item"><strong>Resultado</strong><p>{project.resultado}</p></div>
        </div>
    </div>
</ArticleTag>

<style>
.monolith,
.h-card {
    --op-card-ratio: 16 / 9;
    --op-card-ratio-num: 1.777778;
    --op-card-max-w: 1200px;
    position: relative;
    width: min(92vw, 1200px, var(--op-card-max-w));
    height: auto;
    aspect-ratio: var(--op-card-ratio);
    background: transparent !important;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    display: block;
    box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1);
    pointer-events: auto;
    transition: box-shadow 0.4s, border 0.4s, transform 0.4s;
    transform: translate3d(0,0,0);
    backface-visibility: hidden;
    will-change: transform, opacity;
    cursor: pointer;
}

.monolith:hover,
.h-card:hover {
    box-shadow: 0 40px 80px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.15);
}

:global(.op-scroll-life-target) {
    --op-scroll-life-scale: 1;
    --op-scroll-life-y: 0px;
    --op-scroll-life-opacity: 1;
    transform-origin: 50% 50%;
    transition: box-shadow 0.4s ease, border 0.4s ease, border-color 0.4s ease !important;
    will-change: auto;
    backface-visibility: hidden;
}

:global(.op-scroll-life-target.is-scroll-life-active) {
    will-change: transform, opacity;
}

.monolith.op-scroll-life-target,
.h-card.op-scroll-life-target {
    opacity: 1;
    transform-origin: 50% 50%;
}

.monolith::before,
.h-card::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 100%);
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.4s;
}

.monolith:hover::before,
.h-card:hover::before {
    opacity: 0.7;
}

.m-img-wrap,
.h-img-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: transparent !important;
    transform: translateZ(0);
    z-index: 1;
    border-radius: inherit;
}

:global(.target-img),
:global(.h-img),
:global(.m-img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: translate3d(0,0,0);
    transition: filter 0.8s cubic-bezier(0.19, 1, 0.22, 1);
    filter: grayscale(0.3) brightness(0.8);
    backface-visibility: hidden;
    will-change: transform;
    border-radius: inherit;
    background: transparent !important;
    display: block;
}

@media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .monolith:hover :global(.target-img),
    .h-card:hover :global(.target-img) {
        filter: grayscale(0) brightness(1);
    }
}

.m-content,
.h-info {
    position: absolute;
    bottom: 30px;
    left: 30px;
    width: calc(100% - 60px);
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 3;
    pointer-events: none;
}

.m-meta span,
.h-info .m-meta span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1px;
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 8px;
    display: inline-block;
}

.m-meta span:nth-child(2),
.h-info .m-meta span:nth-child(2) {
    display: none;
}

.m-title,
.h-info h3 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 1.2;
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    text-shadow: none;
}

@media (min-width: 768px) {
    :global(.target-img),
    :global(.h-img) {
        object-fit: cover !important;
        object-position: center center !important;
    }

    .m-title,
    .h-info h3 {
        overflow-wrap: anywhere;
        text-wrap: balance;
    }
}

@media (min-width: 768px) and (max-width: 1180px) {
    .monolith,
    .h-card {
        width: min(88vw, 1080px, var(--op-card-max-w, 1080px));
        height: auto;
        aspect-ratio: var(--op-card-ratio, 16 / 9);
    }

    .m-content,
    .h-info {
        bottom: clamp(22px, 3vw, 30px);
        left: clamp(22px, 3vw, 30px);
        width: calc(100% - clamp(44px, 6vw, 60px));
    }

    .m-title,
    .h-info h3 {
        font-size: clamp(1.05rem, 2vw, 1.7rem);
        line-height: 1.18;
    }
}

@media (min-width: 768px) and (max-width: 1680px), (min-width: 768px) and (max-height: 980px) {
    .monolith,
    .h-card {
        width: min(64vw, 980px, var(--op-card-max-w, 980px));
        max-width: 980px;
    }

    .m-content,
    .h-info {
        bottom: clamp(20px, 2.6vw, 28px);
        left: clamp(20px, 2.6vw, 28px);
        width: calc(100% - clamp(40px, 5.2vw, 56px));
    }

    .m-title,
    .h-info h3 {
        font-size: clamp(1rem, 1.65vw, 1.45rem);
    }
}

@media (max-width: 767px), (max-height: 560px) and (pointer: coarse) {
    .monolith,
    .h-card {
        width: 100% !important;
        height: auto !important;
        aspect-ratio: var(--op-card-ratio, 16 / 9) !important;
        min-height: 0 !important;
        max-height: none !important;
        transform: none !important;
        filter: none !important;
        background: transparent !important;
        pointer-events: auto !important;
        border-radius: 12px !important;
        margin-bottom: 0 !important;
    }

    .m-img-wrap,
    .h-img-wrap {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        border-radius: 12px !important;
    }

    :global(.target-img),
    :global(.h-img) {
        width: 100% !important;
        height: 100% !important;
        left: 0 !important;
        top: 0 !important;
        object-fit: cover !important;
        transform: scale(1) !important;
        filter: grayscale(0) brightness(0.8) !important;
        position: absolute !important;
        display: block !important;
        border-radius: 12px !important;
    }

    .m-content,
    .h-info {
        position: absolute !important;
        bottom: 20px !important;
        left: 20px !important;
        padding: 0 !important;
        overflow: visible !important;
        width: calc(100% - 40px) !important;
        z-index: 3 !important;
    }

    .m-title,
    .h-info h3 {
        font-size: 0.85rem !important;
        line-height: 1.3 !important;
        margin: 0 !important;
        white-space: normal !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
    }

    .m-meta span,
    .h-info .m-meta span {
        font-size: 8px !important;
        padding: 0 !important;
        margin-bottom: 6px !important;
        background: transparent !important;
        border: none !important;
        backdrop-filter: none !important;
    }
}

@media (max-width: 1024px), (pointer: coarse) {
    :global(html.op-mobile-perf) .monolith,
    :global(html.op-mobile-perf) .h-card,
    :global(html.op-mobile-perf .target-img),
    :global(html.op-mobile-perf .h-img),
    :global(html.op-mobile-perf .tilt-target),
    :global(html.op-mobile-perf .skew-target) {
        will-change: auto !important;
        backface-visibility: visible !important;
    }

    :global(html.op-mobile-perf .target-img),
    :global(html.op-mobile-perf .h-img) {
        filter: none !important;
        transition: none !important;
        will-change: auto !important;
        transform: translate3d(0,0,0) !important;
    }

    :global(html.op-mobile-perf) .monolith,
    :global(html.op-mobile-perf) .h-card {
        contain: layout paint style;
        isolation: isolate;
        box-shadow: 0 14px 34px rgba(0,0,0,0.38), inset 0 1px 0 rgba(255,255,255,0.08) !important;
        transition: border-color 0.25s ease !important;
    }

    :global(html.op-mobile-perf) .m-img-wrap::after,
    :global(html.op-mobile-perf) .h-img-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        border-radius: inherit;
        background: rgba(0,0,0,0.14);
    }
}

@media (max-width: 767px) {
    :global(.op-scroll-life-target) {
        filter: none !important;
    }

    .monolith.op-scroll-life-target,
    .h-card.op-scroll-life-target {
        opacity: 1 !important;
        transform-origin: 50% 50% !important;
        will-change: auto !important;
    }

    :global(html.op-mobile-perf .op-scroll-life-target.is-scroll-life-ready),
    :global(html.op-mobile-perf .op-scroll-life-target.is-scroll-life-active) {
        will-change: transform !important;
    }

    :global(html.op-mobile-perf .target-img),
    :global(html.op-mobile-perf .h-img) {
        filter: none !important;
        transition: none !important;
        will-change: auto !important;
    }

    :global(html.op-mobile-perf) .m-img-wrap::after,
    :global(html.op-mobile-perf) .h-img-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: rgba(0,0,0,0.14);
        z-index: 1;
        pointer-events: none;
    }

    :global(html.op-mobile-perf) .monolith.op-scroll-life-mobile,
    :global(html.op-mobile-perf) .h-card.op-scroll-life-mobile {
        transition: border-color 0.4s ease !important;
        transform-origin: 50% 50% !important;
        backface-visibility: hidden !important;
    }

    :global(html.op-mobile-perf) .h-card,
    :global(html.op-mobile-perf) .monolith {
        width: 100% !important;
        max-width: 100% !important;
        aspect-ratio: var(--op-card-ratio, 16 / 9) !important;
        backface-visibility: hidden !important;
        -webkit-backface-visibility: hidden !important;
        transform-style: flat !important;
        perspective: none !important;
    }

    :global(html.op-mobile-perf) .h-card :global(.h-img),
    :global(html.op-mobile-perf) .monolith :global(.target-img) {
        object-fit: cover !important;
        object-position: center center !important;
        transform: translate3d(0,0,0) !important;
        filter: none !important;
        image-rendering: auto;
    }
}

@media (max-width: 420px) {
    .monolith,
    .h-card {
        height: auto !important;
        aspect-ratio: var(--op-card-ratio, 16 / 9) !important;
    }
}
</style>
