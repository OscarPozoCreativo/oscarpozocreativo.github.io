---
interface ProcessStep {
    num: string;
    title: string;
    desc: string;
}

interface Props {
    title: string;
    steps: ProcessStep[];
}

const { title, steps } = Astro.props;
---

<section class="process-wrapper" id="metodo">
    <div class="section-header"><h2 class="has-reveal">{title}</h2></div>
    <div class="process-grid">
        {steps.map((step) => (
            <article class="p-card">
                <span class="p-num">{step.num}</span>
                <h3 class="p-title">{step.title}</h3>
                <p class="p-desc">{step.desc}</p>
            </article>
        ))}
    </div>
</section>

<style>
.process-wrapper {
    background: transparent !important;
    position: relative;
    z-index: 10;
    padding: clamp(60px, 8vh, 100px) 5vw;
    border-top: 1px solid var(--border);
}

.section-header {
    text-align: center;
    margin-bottom: 60px;
}

.section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
}

.process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(20px, 3vw, 40px);
    max-width: 1400px;
    margin: 0 auto;
}

.p-card {
    padding: 40px;
    /* Gradiente más sólido para compensar la reducción del blur */
    background: linear-gradient(145deg, rgba(20,20,20,0.8) 0%, rgba(10,10,10,0.9) 100%);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    
    /* Reducimos el blur drásticamente. 10px da el efecto sin matar los FPS */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    
    /* Forzamos aceleración por hardware correcta */
    transform: translateZ(0); 
    
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), border-color 0.3s;
    
    /* ELIMINADO: will-change: transform, opacity; (Esto causaba el 80% de tu lag) */
}

.p-card:hover {
    transform: translateY(-10px) translateZ(0);
    border-color: rgba(255,255,255,0.15);
}

.p-num {
    font-family: var(--font-display);
    font-size: 3rem;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    display: block;
    margin-bottom: 20px;
    font-weight: 700;
    transition: all 0.3s;
}

.p-card:hover .p-num {
    -webkit-text-stroke: 1px var(--accent);
    color: rgba(64,181,229,0.1);
}

.p-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.p-desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
}

@media (max-width: 767px), (max-height: 560px) and (pointer: coarse) {
    .process-wrapper {
        padding: 40px 15px !important;
        pointer-events: auto !important;
        background: transparent !important;
    }

    .process-grid {
        grid-template-columns: 1fr !important;
        gap: 20px !important;
    }

    .p-card {
        padding: 25px !important;
        width: 100% !important;
        transform: none !important;
    }
}

@media (max-width: 1024px), (pointer: coarse) {
    :global(html.op-mobile-perf) .process-wrapper {
        content-visibility: auto;
        contain-intrinsic-size: 1px 900px;
    }

    :global(html.op-mobile-perf) .p-card {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
    }
}

@media (max-width: 767px) {
    .p-card {
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }
}
</style>
