---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';

interface VaultItem {
    title: string;
    img: string;
    meta: string;
    summary: string;
    reto: string;
    enfoque: string;
    resultado: string;
}

interface Props {
    title: string;
    items: VaultItem[];
}

const { title, items } = Astro.props;
---

<section class="vault-wrapper" id="mas-proyectos">
    <div class="section-header"><h2 class="has-reveal">{title}</h2></div>
    <div class="vault-grid">
        {items.map((item) => (
            <article
                class="v-item hover-target lb-trigger tilt-target skew-target"
                tabindex="0"
                role="button"
                aria-label="Abrir proyecto"
                data-title={item.title}
            >
                <Image src={resolveImage(item.img)} alt={item.title} class="v-bg target-img" width={600} height={400} />
                <div class="v-info"><span>{item.meta}</span><h4>{item.title}</h4></div>
                <div class="project-details" style="display:none;">
                    <p class="m-summary">{item.summary}</p>
                    <div class="m-item"><strong>Reto</strong><p>{item.reto}</p></div>
                    <div class="m-item"><strong>Enfoque</strong><p>{item.enfoque}</p></div>
                    <div class="m-item"><strong>Resultado</strong><p>{item.resultado}</p></div>
                </div>
            </article>
        ))}
    </div>
</section>

<style>
.vault-wrapper {
    background: transparent !important;
    position: relative;
    z-index: 10;
    padding: clamp(60px, 8vh, 100px) 5vw;
    border-top: 1px solid var(--border);
}

.section-header {
    text-align: center;
    margin-bottom: 60px;
}

.section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
}

.vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3vw, 40px);
    max-width: 1400px;
    margin: 0 auto;
}

.v-item {
    position: relative;
    height: 280px;
    border-radius: 12px;
    overflow: hidden;
    pointer-events: auto;
    border: 1px solid var(--border);
    transition: border 0.5s;
    transform: translate3d(0,0,0);
    backface-visibility: hidden;
    will-change: transform, opacity;
    cursor: pointer;
}

.v-item::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%);
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.4s;
}

.v-item:hover::before {
    opacity: 0.7;
}

:global(.v-bg),
:global(.target-img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: translate3d(0,0,0);
    transition: filter 0.8s cubic-bezier(0.19, 1, 0.22, 1);
    filter: grayscale(0.3) brightness(0.8);
    backface-visibility: hidden;
    will-change: transform;
    border-radius: inherit;
    background: transparent !important;
    display: block;
    z-index: 1;
}

@media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .v-item:hover :global(.v-bg),
    .v-item:hover :global(.target-img) {
        filter: grayscale(0) brightness(1);
    }
}

.v-info {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 3;
    pointer-events: none;
}

.v-info h4 {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 6px;
    line-height: 1.3;
    color: #fff;
}

.v-info span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 8px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1px;
}

@media (min-width: 768px) {
    :global(.v-bg) {
        object-fit: cover !important;
        object-position: center center !important;
    }

    .v-info h4 {
        overflow-wrap: anywhere;
        text-wrap: balance;
    }
}

@media (max-width: 767px), (max-height: 560px) and (pointer: coarse) {
    .vault-wrapper {
        padding: 40px 15px !important;
        pointer-events: auto !important;
        background: transparent !important;
    }

    .vault-grid {
        gap: 40px !important;
        grid-template-columns: 1fr !important;
    }

    .v-item {
        width: 100% !important;
        height: auto !important;
        aspect-ratio: var(--op-card-ratio, 16 / 9) !important;
        min-height: 0 !important;
        max-height: none !important;
        transform: none !important;
        filter: none !important;
        background: transparent !important;
        pointer-events: auto !important;
        border-radius: 12px !important;
        margin-bottom: 0 !important;
    }

    :global(.v-bg),
    :global(.target-img) {
        width: 100% !important;
        height: 100% !important;
        left: 0 !important;
        top: 0 !important;
        object-fit: cover !important;
        transform: scale(1) !important;
        filter: grayscale(0) brightness(0.8) !important;
        position: absolute !important;
        display: block !important;
        border-radius: 12px !important;
    }

    .v-info {
        position: absolute !important;
        bottom: 20px !important;
        left: 20px !important;
        padding: 0 !important;
        overflow: visible !important;
        width: calc(100% - 40px) !important;
        z-index: 3 !important;
    }

    .v-info h4 {
        font-size: 0.85rem !important;
        line-height: 1.3 !important;
        margin: 0 !important;
        white-space: normal !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
    }

    .v-info span {
        font-size: 8px !important;
        padding: 0 !important;
        margin-bottom: 6px !important;
        background: transparent !important;
        border: none !important;
        backdrop-filter: none !important;
    }
}

@media (max-width: 1024px), (pointer: coarse) {
    :global(html.op-mobile-perf) .vault-wrapper {
        content-visibility: visible !important;
        contain-intrinsic-size: auto !important;
    }

    :global(html.op-mobile-perf) .v-item,
    :global(html.op-mobile-perf .v-bg),
    :global(html.op-mobile-perf .target-img),
    :global(html.op-mobile-perf .tilt-target),
    :global(html.op-mobile-perf .skew-target) {
        will-change: auto !important;
        backface-visibility: visible !important;
    }

    :global(html.op-mobile-perf .v-bg),
    :global(html.op-mobile-perf .target-img) {
        filter: none !important;
        transition: none !important;
        will-change: auto !important;
        transform: translate3d(0,0,0) !important;
    }

    :global(html.op-mobile-perf) .v-item {
        contain: layout paint style;
        isolation: isolate;
        box-shadow: 0 14px 34px rgba(0,0,0,0.38), inset 0 1px 0 rgba(255,255,255,0.08) !important;
        transition: border-color 0.25s ease !important;
    }

    :global(html.op-mobile-perf) .v-item::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        border-radius: inherit;
        background: rgba(0,0,0,0.12);
    }
}

@media (max-width: 767px) {
    :global(html.op-mobile-perf) .v-item.op-scroll-life-mobile {
        transition: border-color 0.4s ease !important;
        transform-origin: 50% 50% !important;
        backface-visibility: hidden !important;
    }

    :global(html.op-mobile-perf) .v-item {
        width: 100% !important;
        max-width: 100% !important;
        aspect-ratio: var(--op-card-ratio, 16 / 9) !important;
    }

    :global(html.op-mobile-perf) .v-item :global(.v-bg) {
        object-fit: cover !important;
        object-position: center center !important;
        transform: translate3d(0,0,0) !important;
        filter: none !important;
    }
}

@media (max-width: 420px) {
    .v-item {
        height: auto !important;
        aspect-ratio: var(--op-card-ratio, 16 / 9) !important;
    }
}
</style>
