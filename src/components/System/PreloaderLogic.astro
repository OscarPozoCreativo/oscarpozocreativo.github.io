---
// src/components/System/PreloaderLogic.astro
---
<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const OP_SKIP_LOADER_ONCE_KEY = 'op-skip-loader-once';
    const OP_LEGACY_SESSION_LOADER_KEY = 'op-loader-done';
    let opAppStarted = false;
    let opEntranceStarted = false;
    let opLoaderInterval: number | undefined;
    let opLoaderFailsafe: number | undefined;

    function opSafeStorageGet(key: string) { try { return sessionStorage.getItem(key); } catch (_) { return null; } }
    function opSafeStorageSet(key: string, value: string) { try { sessionStorage.setItem(key, value); } catch (_) {} }
    function opSafeStorageRemove(key: string) { try { sessionStorage.removeItem(key); } catch (_) {} }
    
    window.opSetSkipLoaderOnce = function() { opSafeStorageSet(OP_SKIP_LOADER_ONCE_KEY, '1'); };
    window.opConsumeSkipLoaderOnce = function() {
        const shouldSkip = opSafeStorageGet(OP_SKIP_LOADER_ONCE_KEY) === '1';
        opSafeStorageRemove(OP_SKIP_LOADER_ONCE_KEY); opSafeStorageRemove(OP_LEGACY_SESSION_LOADER_KEY);
        return shouldSkip;
    };

    function opMarkLoaderDone() { document.documentElement.classList.add('op-loader-complete', 'op-page-ready'); }

    window.opHardReleaseLoader = function() {
        const sysInit = document.getElementById('system-init');
        if (opLoaderInterval) window.clearInterval(opLoaderInterval);
        if (opLoaderFailsafe) window.clearTimeout(opLoaderFailsafe);
        const pctEl = document.getElementById('loader-pct');
        if (pctEl) pctEl.textContent = '[100%]';
        opMarkLoaderDone();
        if (sysInit) {
            gsap.killTweensOf(sysInit);
            sysInit.style.transform = 'translate3d(0,-100%,0)'; sysInit.style.opacity = '0'; sysInit.style.visibility = 'hidden'; sysInit.style.pointerEvents = 'none'; sysInit.style.display = 'none';
        }
    };

    function splitTextForReveal(selector) {
        document.querySelectorAll(selector).forEach(el => {
            if(!el.innerHTML.includes('<') || el.innerHTML.includes('<br>')) {
                const text = el.innerText;
                el.innerHTML = text.split(' ').map(word => `<span class="reveal-wrap"><span class="reveal-text">${word}</span></span>`).join(' ');
            }
        });
    }

    function initTypographyChoreography() {
        splitTextForReveal('.has-reveal');
        document.querySelectorAll('.has-reveal').forEach(title => {
            gsap.set(title, { opacity: 1 }); 
            const chars = title.querySelectorAll('.reveal-text');
            if(chars.length > 0) { 
                gsap.to(chars, { y: '0%', opacity: 1, filter: "blur(0px)", duration: 0.8, ease: 'power3.out', stagger: 0.05, scrollTrigger: { trigger: title, start: "top 85%", toggleActions: "play none none reverse" } }); 
            }
        });
    }

    window.opRunEntranceAnimations = function() {
        if (opEntranceStarted) return;
        opEntranceStarted = true;

        if (window.opIsMobilePerf()) {
            gsap.set('.has-reveal:not(.hero-title), .has-reveal:not(.hero-title) .reveal-text, .scroll-indicator, .v-item, .p-card, .profile-main p, .profile-sidebar, .t-focus-item, .t-panel > *, .monolith, .h-card, .reel-item', {
                opacity: 1, x: 0, y: 0, yPercent: 0, xPercent: 0, filter: 'none', clearProps: 'transform'
            });

            const heroTitle = document.querySelector('.hero-title');
            const heroPieces = gsap.utils.toArray('.hero-title .reveal-text');
            if (heroTitle) gsap.set(heroTitle, { opacity: 1 });

            if (heroPieces.length) {
                gsap.set(heroPieces, { y: '115%', opacity: 0, filter: 'blur(8px)', willChange: 'transform, opacity, filter', force3D: true });
                gsap.to(heroPieces, { y: '0%', opacity: 1, filter: 'blur(0px)', duration: 0.9, ease: 'power3.out', stagger: 0.085, delay: 0.04, force3D: true, clearProps: 'willChange,filter' });
            } else if (heroTitle) {
                gsap.fromTo(heroTitle, { y: 24, opacity: 0, filter: 'blur(8px)' }, { y: 0, opacity: 1, filter: 'blur(0px)', duration: 0.85, ease: 'power3.out', force3D: true, clearProps: 'filter' });
            }

            gsap.fromTo('.hero-desc', { y: 18, opacity: 0, filter: 'blur(7px)' }, { y: 0, opacity: 1, filter: 'blur(0px)', duration: 0.85, delay: 0.28, ease: 'power3.out', force3D: true, clearProps: 'filter' });
            requestAnimationFrame(() => ScrollTrigger.refresh());
            return;
        }

        gsap.to('.hero-title .reveal-text', { y: '0%', opacity: 1, filter: "blur(0px)", duration: 1, ease: 'power3.out', stagger: 0.1 });
        gsap.to('.hero-desc', { y: 0, opacity: 1, duration: 1, delay: 0.35 });
        gsap.to('.scroll-indicator', { opacity: 1, duration: 1, delay: 0.65 });
        
        initTypographyChoreography();

        gsap.fromTo('.v-item', { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".vault-grid", start: "top 85%" } });
        gsap.fromTo('.p-card', { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: "power3.out", scrollTrigger: { trigger: ".process-grid", start: "top 85%" } });
        gsap.fromTo('.profile-main p', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".profile-main", start: "top 80%" } });
        gsap.fromTo('.profile-sidebar', { x: 50, opacity: 0 }, { x: 0, opacity: 1, duration: 1, ease: "power3.out", scrollTrigger: { trigger: ".profile-grid", start: "top 80%" } });
        gsap.fromTo('.t-focus-item', { x: 20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".t-focus-list", start: "top 85%" } });
        gsap.fromTo('.t-panel > *', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".terminal-grid", start: "top 85%" } });

        if(window.opIsPhoneLikeViewport()) {
            gsap.utils.toArray('.monolith, .h-card, .reel-item').forEach(el => {
                gsap.fromTo(el, { y: 42, opacity: 0 }, { y: 0, opacity: 1, duration: 0.75, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 90%" } });
            });
        }
        ScrollTrigger.refresh();
    };

    function initApp() {
        if (opAppStarted) return;
        opAppStarted = true;

        window.scrollTo(0, 0);
        if(window.lenis) window.lenis.scrollTo(0, { immediate: true });

        const sysInit = document.getElementById('system-init');
        const pctEl = document.getElementById('loader-pct');
        const shouldSkipLoader = window.opConsumeSkipLoaderOnce() || document.documentElement.classList.contains('op-loader-complete');

        if (!sysInit || shouldSkipLoader) {
            window.opHardReleaseLoader();
            window.opRunEntranceAnimations();
            return;
        }

        document.documentElement.classList.add('op-loader-active');
        sysInit.style.display = 'flex'; sysInit.style.visibility = 'visible'; sysInit.style.opacity = '1'; sysInit.style.pointerEvents = 'auto'; sysInit.style.transform = 'translate3d(0,0,0)';

        let pct = 0; let completeCalled = false;
        const updatePct = (value: number) => {
            pct = Math.max(pct, Math.min(100, Math.round(value)));
            if (pctEl) pctEl.textContent = `[${pct.toString().padStart(3, '0')}%]`;
        };

        const completeLoader = () => {
            if (completeCalled) return;
            completeCalled = true;
            if (opLoaderInterval) window.clearInterval(opLoaderInterval);
            if (opLoaderFailsafe) window.clearTimeout(opLoaderFailsafe);

            updatePct(100);
            document.documentElement.classList.remove('op-loader-active');
            document.documentElement.classList.add('op-loader-holding-100');

            const releaseLoaderVisual = () => {
                requestAnimationFrame(() => {
                    updatePct(100);
                    window.setTimeout(() => {
                        updatePct(100);
                        document.documentElement.classList.remove('op-loader-holding-100');
                        gsap.to(sysInit, { 
                            yPercent: -100, autoAlpha: 0, duration: 0.95, ease: "power4.inOut", 
                            onComplete: () => {
                                sysInit.style.display = 'none'; sysInit.style.pointerEvents = 'none';
                                opMarkLoaderDone(); window.opRunEntranceAnimations();
                            }
                        });
                    }, 220);
                });
            };

            if (window.opIsMobilePerf() && typeof window.opMobilePreEntranceMediaWarmup === 'function') {
                window.opMobilePreEntranceMediaWarmup(window.opRuntimeLowPower ? 260 : 420).then(releaseLoaderVisual).catch(releaseLoaderVisual);
            } else { releaseLoaderVisual(); }
        };

        opLoaderInterval = window.setInterval(() => {
            const increment = pct < 68 ? 7 : pct < 90 ? 4 : 2;
            updatePct(Math.min(96, pct + increment));
        }, 18);

        if (document.readyState === 'complete') window.setTimeout(completeLoader, 260);
        else window.addEventListener('load', () => window.setTimeout(completeLoader, 180), { once: true });

        opLoaderFailsafe = window.setTimeout(completeLoader, 1650);
    }

    document.addEventListener('astro:page-load', () => {
        if (document.readyState === 'complete' || document.readyState === 'interactive') setTimeout(initApp, 50);
        else window.addEventListener('DOMContentLoaded', initApp, { once: true });
    });
</script>