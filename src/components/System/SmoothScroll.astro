<script>
            import Lenis from '@studio-freight/lenis';
            import { gsap } from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';

            gsap.registerPlugin(ScrollTrigger);

            let globalScrollVelocity = 0;
            let opProgrammaticTopScrollUntil = 0;
            // --- 1. SCROLL PREMIUM SIN TIRONES EN MÓVIL ---
            const opPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const opCoarsePointer = window.matchMedia('(pointer: coarse)');
            const opViewportWidth = () => Math.round(window.visualViewport?.width || window.innerWidth || 0);
            const opViewportHeight = () => Math.round(window.visualViewport?.height || window.innerHeight || 0);
            const opIsPhoneLikeViewport = () => opViewportWidth() < 768 || (opCoarsePointer.matches && opViewportHeight() <= 560);
            const opIsMobilePerf = () => opIsPhoneLikeViewport();
            const opHasTouchViewport = () => opCoarsePointer.matches || navigator.maxTouchPoints > 0;
            const opRuntimeSaveData = Boolean((navigator as any).connection?.saveData);
            const opRuntimeDeviceMemory = Number((navigator as any).deviceMemory || 4);
            const opRuntimeCpuCores = Number(navigator.hardwareConcurrency || 4);
            const opRuntimeLowPower = opRuntimeSaveData || opRuntimeDeviceMemory <= 2 || opRuntimeCpuCores <= 4;
            const opRuntimeTouchDesktopMode = opHasTouchViewport() && opViewportWidth() >= 768 && opViewportWidth() <= 1180;
            const opRuntimeConstrainedTouch = opHasTouchViewport() && (opRuntimeLowPower || opRuntimeTouchDesktopMode);
            const opPerfStressSignal = () => {
                document.documentElement.classList.add('op-perf-stress');
                document.dispatchEvent(new CustomEvent('op:perf-stress'));
            };
            try {
                if ('PerformanceObserver' in window) {
                    let opLongTaskBudget = 0;
                    const opLongTaskObserver = new PerformanceObserver((list) => {
                        opLongTaskBudget += list.getEntries().filter((entry) => entry.duration > 70).length;
                        if (opLongTaskBudget >= 3) {
                            opLongTaskBudget = 0;
                            opPerfStressSignal();
                        }
                    });
                    opLongTaskObserver.observe({ entryTypes: ['longtask'] });
                }
            } catch (_) {}
            const opIdle = (cb: () => void, timeout = 700) => {
                if ('requestIdleCallback' in window) return (window as any).requestIdleCallback(cb, { timeout });
                return window.setTimeout(cb, Math.min(timeout, 160));
            };
            const opIsTabletPortraitViewport = () => {
                const w = opViewportWidth();
                const h = opViewportHeight();
                return opHasTouchViewport() && w >= 768 && w <= 1180 && h > w;
            };
            const opUseStackedProjectLightbox = () => opViewportWidth() < 768 || opIsTabletPortraitViewport();
            const opUseSmoothScroll = !(opIsMobilePerf() || opRuntimeConstrainedTouch);
            let opLastScrollInputAt = 0;
            const opMarkScrollInput = () => { opLastScrollInputAt = performance.now(); };
            if (opIsMobilePerf() || opRuntimeConstrainedTouch) {
                ScrollTrigger.config({ ignoreMobileResize: true, autoRefreshEvents: 'visibilitychange,DOMContentLoaded,load' });
            }

			const lenis = new Lenis({
                duration: opUseSmoothScroll ? 0.95 : 0.001,
                smoothWheel: opUseSmoothScroll,
                smoothTouch: false,
                syncTouch: false,
                touchMultiplier: 1,
                wheelMultiplier: opRuntimeLowPower ? 0.82 : 0.9
            });

            function opIsProgrammaticTopScrollActive() {
                return opUseSmoothScroll && performance.now() < opProgrammaticTopScrollUntil;
            }

            function opPrimeWebglForTopScroll(durationMs = 1600) {
                if (!opUseSmoothScroll) return;
                opProgrammaticTopScrollUntil = Math.max(opProgrammaticTopScrollUntil, performance.now() + durationMs);
                globalScrollVelocity = 0;
                document.dispatchEvent(new CustomEvent('op:webgl-home-resync'));
            }

            function opFinishWebglTopScrollSync() {
                globalScrollVelocity = 0;
                document.dispatchEvent(new CustomEvent('op:webgl-home-resync'));
                requestAnimationFrame(() => {
                    ScrollTrigger.refresh();
                    document.dispatchEvent(new CustomEvent('op:webgl-home-resync'));
                });
            }

            function opScrollToTopPreservingWebgl(duration = 1.5) {
                if (!opUseSmoothScroll) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    return;
                }

                const durationMs = Math.max(300, Math.round(duration * 1000) + 360);
                opPrimeWebglForTopScroll(durationMs);
                lenis.start();
                lenis.scrollTo(0, { duration, immediate: false });
                window.setTimeout(opFinishWebglTopScrollSync, 120);
                window.setTimeout(opFinishWebglTopScrollSync, durationMs);
            }
            
            const skewTargets = Array.from(document.querySelectorAll('.skew-target')) as HTMLElement[];
            let opSkewRaf = 0;
            let opLastSkewAt = 0;
            let opLastAppliedSkew = 999;
            let opPendingSkew = 0;

            function opScheduleSkewUpdate(velocity = 0) {
                if (!opUseSmoothScroll || opRuntimeLowPower || window.innerWidth <= 1024 || !skewTargets.length) return;
                const nextSkew = Math.max(-4, Math.min(4, velocity * 0.16));
                if (Math.abs(nextSkew - opLastAppliedSkew) < 0.055) return;
                opPendingSkew = nextSkew;
                if (opSkewRaf) return;

                opSkewRaf = requestAnimationFrame((now) => {
                    opSkewRaf = 0;
                    if (now - opLastSkewAt < 42) {
                        opSkewRaf = requestAnimationFrame(() => {
                            opSkewRaf = 0;
                            opScheduleSkewUpdate(opPendingSkew / 0.16);
                        });
                        return;
                    }
                    opLastSkewAt = now;
                    opLastAppliedSkew = opPendingSkew;
                    const viewportH = window.innerHeight || 1;
                    skewTargets.forEach((el) => {
                        const rect = el.getBoundingClientRect();
                        if (rect.top < viewportH + 80 && rect.bottom > -80) {
                            gsap.to(el, { skewY: opPendingSkew, duration: 0.34, ease: "power2.out", overwrite: "auto", force3D: true });
                        }
                    });
                });
            }

            function opUpdateScrollUI(scrollValue = window.scrollY, velocity = 0) {
                const scrollable = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
                const progress = Math.max(0, Math.min(1, scrollValue / scrollable));
                const pb = document.getElementById('progress-bar');
                if(pb) pb.style.transform = `scaleX(${progress}) translateZ(0)`;
                
                globalScrollVelocity = (opUseSmoothScroll && !opIsProgrammaticTopScrollActive()) ? (velocity || 0) : 0;
                (window as any).__opScrollVelocity = globalScrollVelocity;
                document.dispatchEvent(new CustomEvent('op:scroll-velocity', { detail: { velocity: globalScrollVelocity } }));

                opScheduleSkewUpdate(globalScrollVelocity);
            }

            function opExposeSmoothRuntime() {
                (window as any).__opLenis = lenis;
                (window as any).__opScrollVelocity = globalScrollVelocity;
                (window as any).__opRuntime = {
                    opPrefersReducedMotion,
                    opCoarsePointer,
                    opViewportWidth,
                    opViewportHeight,
                    opIsPhoneLikeViewport,
                    opIsMobilePerf,
                    opHasTouchViewport,
                    opRuntimeSaveData,
                    opRuntimeDeviceMemory,
                    opRuntimeCpuCores,
                    opRuntimeLowPower,
                    opRuntimeTouchDesktopMode,
                    opRuntimeConstrainedTouch,
                    opUseStackedProjectLightbox,
                    opUseSmoothScroll,
                    opIdle
                };
                (window as any).__opSmoothScroll = {
                    lenis,
                    opUseSmoothScroll,
                    opIsProgrammaticTopScrollActive,
                    opPrimeWebglForTopScroll,
                    opFinishWebglTopScrollSync,
                    opScrollToTopPreservingWebgl,
                    opUpdateScrollUI
                };
                document.dispatchEvent(new CustomEvent('op:smoothscroll-ready', { detail: (window as any).__opSmoothScroll }));
            }

            opExposeSmoothRuntime();

            if (opUseSmoothScroll) {
                lenis.on('scroll', (e) => {
                    opMarkScrollInput();
                    ScrollTrigger.update();
                    opUpdateScrollUI(e.animatedScroll, e.velocity || 0);
                });
			    gsap.ticker.add((time) => { lenis.raf(time * 1000); });
			    gsap.ticker.lagSmoothing(0, 0);
            } else {
                let opNativeScrollRaf = 0;
                window.addEventListener('scroll', () => {
                    opMarkScrollInput();
                    if (opNativeScrollRaf) return;
                    opNativeScrollRaf = requestAnimationFrame(() => {
                        opNativeScrollRaf = 0;
                        opUpdateScrollUI(window.scrollY, 0);
                        (window as any).__opMobileScrollLifeTick?.();
                    });
                }, { passive: true });
            }

            // --- 4. GSAP HORIZONTAL ---
            let opHorizontalPortfolioTween = null;
            let opReelsScrollTween = null;
            let mm = gsap.matchMedia();
            mm.add("(min-width: 768px)", () => {
                
                const zLayers = gsap.utils.toArray('.z-layer'); 
                if(zLayers.length) {
                    gsap.set(zLayers.slice(1), { scale: 0.1, autoAlpha: 0, filter: "blur(5px)" });
                    let zTl = gsap.timeline({ scrollTrigger: { trigger: ".z-wrapper", start: "top top", end: "+=400%", pin: true, scrub: 0.5 } });
                    zTl.to('.layer-hero', { autoAlpha: 0, scale: 0.8, filter: "blur(5px)", duration: 1 }, 0);
                    zLayers.forEach((layer, i) => {
                        if (i !== 0) { 
                            let start = (i * 3) - 2; 
                            zTl.fromTo(layer, { scale: 0.1, autoAlpha: 0, filter: "blur(5px)" }, { scale: 1, autoAlpha: 1, filter: "blur(0px)", duration: 1 }, start); 
                            zTl.to(layer, { scale: 1, duration: 2 }, start + 1);
                            if (i !== zLayers.length - 1) { zTl.to(layer, { scale: 5, autoAlpha: 0, filter: "blur(5px)", duration: 1 }, start + 3); }
                        }
                    });
                }

                const hPanels = gsap.utils.toArray('.h-panel');
                if(hPanels.length) {
                    opHorizontalPortfolioTween = gsap.to(hPanels, { 
                        xPercent: -100 * (hPanels.length - 1), ease: "none", 
                        scrollTrigger: { trigger: ".h-wrapper", pin: true, scrub: 1, end: () => "+=" + (document.querySelector(".h-container").offsetWidth) } 
                    });
                }

                const reelsTrack = document.querySelector('.reels-track');
                if(reelsTrack) {
                    let getScrollAmount = () => reelsTrack.scrollWidth - window.innerWidth + (window.innerWidth * 0.05);
                    opReelsScrollTween = gsap.to(reelsTrack, { x: () => -getScrollAmount(), ease: "none", scrollTrigger: { trigger: ".reels-wrapper", pin: true, scrub: 1, end: () => "+=" + (reelsTrack.scrollWidth) } });
                }
            });

            // --- 5. MAGNETISMO ---
            if(window.innerWidth > 768) {
                document.querySelectorAll('.magnetic-target').forEach(btn => {
                    const xTo = gsap.quickTo(btn, "x", {duration: 0.3, ease: "power2.out"}); 
                    const yTo = gsap.quickTo(btn, "y", {duration: 0.3, ease: "power2.out"});
                    
                    btn.addEventListener('mousemove', (e) => { 
                        const rect = btn.getBoundingClientRect(); 
                        const x = (e.clientX - rect.left - rect.width / 2) * 0.3; 
                        const y = (e.clientY - rect.top - rect.height / 2) * 0.3;
                        xTo(x); yTo(y); 
                    });
                    btn.addEventListener('mouseleave', () => { xTo(0); yTo(0); });
                });
            }


            document.addEventListener('astro:before-swap', () => {
                try { ScrollTrigger.getAll().forEach((trigger) => trigger.kill()); } catch (_) {}
                try { lenis.destroy?.(); } catch (_) {}
                if ((window as any).__opLenis === lenis) (window as any).__opLenis = null;
                if ((window as any).__opSmoothScroll?.lenis === lenis) (window as any).__opSmoothScroll = null;
            });
</script>
