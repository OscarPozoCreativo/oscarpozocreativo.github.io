---
---
<canvas id="webgl-canvas" style="position: fixed; inset: 0; z-index: -2; pointer-events: none; width: 100vw; height: 100vh;"></canvas>
<div class="noise-overlay" style="position: fixed; inset: 0; z-index: -1; opacity: 0.03; pointer-events: none; background-image: url('data:image/svg+xml,%3Csvg viewBox=\\'0 0 200 200\\' xmlns=\\'http://www.w3.org/2000/svg\\'%3E%3Cfilter id=\\'noiseFilter\\'%3E%3CfeTurbulence type=\\'fractalNoise\\' baseFrequency=\\'0.9\\' numOctaves=\\'3\\' stitchTiles=\\'stitch\\'/%3E%3C/filter%3E%3Crect width=\\'100%25\\' height=\\'100%25\\' filter=\\'url(%23noiseFilter)\\'/%3E%3C/svg%3E'); mix-blend-mode: overlay;"></div>

<script>
	import * as THREE from 'three';

    let targetMouseX = 0; let targetMouseY = 0;
    window.addEventListener('mousemove', (e) => {
        targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
        targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
    }, {passive: true});

	const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement;
	if(canvas) {
		const renderer = new THREE.WebGLRenderer({ canvas, alpha: false, powerPreference: "high-performance" });
		const isMobileInit = window.innerWidth <= 768;
        renderer.setPixelRatio(isMobileInit ? 1 : Math.min(window.devicePixelRatio, 1.25));
        renderer.setSize(window.innerWidth, window.innerHeight);
		
		const sceneDark = new THREE.Scene();
		sceneDark.background = new THREE.Color('#050505');
		const cameraDark = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
		cameraDark.position.z = 100;

		const particleCount = isMobileInit ? 250 : 800;
		const posArray = new Float32Array(particleCount * 3);
		for(let i=0; i<particleCount*3; i++) { posArray[i] = (Math.random() - 0.5) * 200; }
		
		const particlesGeom = new THREE.BufferGeometry();
		particlesGeom.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
		const particlesMat = new THREE.PointsMaterial({ size: 0.8, color: '#ffffff', transparent: true, opacity: 0.15, blending: THREE.AdditiveBlending });
		const particleSystem = new THREE.Points(particlesGeom, particlesMat);
		sceneDark.add(particleSystem);

        const sceneLight = new THREE.Scene(); sceneLight.background = new THREE.Color('#f0f1fa');
        const cameraLight = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000); cameraLight.position.z = 50;
        sceneLight.add(new THREE.AmbientLight(0xffffff, 0.6));
        const dirLight = new THREE.DirectionalLight(0xffffff, 1); dirLight.position.set(10, 20, 10); sceneLight.add(dirLight);

        const shapeGeom = new THREE.TorusGeometry(10, 3, 32, 64);
        const shapeMat = new THREE.MeshPhysicalMaterial({ color: 0xffffff, metalness: 0.1, roughness: 0.2, transmission: 0.9, ior: 1.5, thickness: 2.0, clearcoat: 1.0, transparent: true });
        const lightObject = new THREE.Mesh(shapeGeom, shapeMat); sceneLight.add(lightObject);

        window.addEventListener('resize', () => { 
            renderer.setSize(window.innerWidth, window.innerHeight);
            cameraDark.aspect = window.innerWidth / window.innerHeight; cameraDark.updateProjectionMatrix();
            cameraLight.aspect = window.innerWidth / window.innerHeight; cameraLight.updateProjectionMatrix();
        });

		const animate = () => {
            const isMobile = window.innerWidth <= 768;
            const hWrapperEl = document.querySelector('.h-wrapper');
            let hRect = hWrapperEl ? hWrapperEl.getBoundingClientRect() : { top: 0, bottom: 0 };
            let hTop = Math.max(0, hRect.top); let hBottom = Math.min(window.innerHeight, hRect.bottom);
            let isHWrapperFullViewport = (hRect.top <= 0 && hRect.bottom >= window.innerHeight);

            if (isMobile) {
                const positions = particleSystem.geometry.attributes.position.array;
                for(let i=1; i<particleCount*3; i+=3) {
                    positions[i] += 0.02; 
                    if(positions[i] > 100) positions[i] = -100; if(positions[i] < -100) positions[i] = 100;
                }
                particleSystem.geometry.attributes.position.needsUpdate = true; 
                particleSystem.rotation.y += 0.0005; 
                renderer.setScissorTest(false);
                renderer.render(sceneDark, cameraDark);
            } else {
                cameraDark.position.x += (targetMouseX * 15 - cameraDark.position.x) * 0.05;
                cameraDark.position.y += (targetMouseY * 15 - cameraDark.position.y) * 0.05;
                cameraDark.lookAt(sceneDark.position);

                if (!isHWrapperFullViewport) {
                    const positions = particleSystem.geometry.attributes.position.array;
                    for(let i=1; i<particleCount*3; i+=3) {
                        positions[i] += 0.05; 
                        if(positions[i] > 100) positions[i] = -100; if(positions[i] < -100) positions[i] = 100;
                    }
                    particleSystem.geometry.attributes.position.needsUpdate = true; particleSystem.rotation.y += 0.001;
                }

                if (hBottom > hTop) {
                    lightObject.rotation.x += 0.01; 
                    lightObject.rotation.y += 0.01; 
                    lightObject.position.y = Math.sin(Date.now() * 0.001) * 2;
                }

                renderer.setScissorTest(false);
                if (!isHWrapperFullViewport) { renderer.render(sceneDark, cameraDark); }

                if (hBottom > hTop) {
                    renderer.setScissorTest(true);
                    renderer.setScissor(0, window.innerHeight - hBottom, window.innerWidth, hBottom - hTop);
                    renderer.render(sceneLight, cameraLight); 
                    renderer.setScissorTest(false);
                }
            }
			requestAnimationFrame(animate);
		};
		animate();
	}
</script>