---
// src/pages/en.astro (English)
import Layout from '../layouts/Layout.astro';
import data from '../data/en.json';
import HeroStack from '../components/Sections/HeroStack.astro';
import HorizontalProjects from '../components/Sections/HorizontalProjects.astro';
import ReelsSection from '../components/Sections/ReelsSection.astro';
import VaultSection from '../components/Sections/VaultSection.astro';
import ProcessSection from '../components/Sections/ProcessSection.astro';
import ProfileSection from '../components/Sections/ProfileSection.astro';
import ContactSection from '../components/Sections/ContactSection.astro';
---

<Layout
    title="Oscar Pozo | Senior Graphic Designer"
    description={data.hero.desc}
    lang="en"
    nav={data.nav}
    footer={data.footer}
>
    <HeroStack hero={data.hero} projects={data.zProjects} />
    <HorizontalProjects projects={data.hProjects} />
    <ReelsSection title={data.reelsTitle} reels={data.reels} />
    <VaultSection title={data.vaultTitle} items={data.vault} />
    <ProcessSection title={data.processTitle} steps={data.process} />
    <ProfileSection profile={data.profile} />
    <ContactSection contact={data.contact} />
</Layout>
