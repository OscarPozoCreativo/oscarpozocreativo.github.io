---
import DesignLayout from '../../layouts/DesignLayout.astro';
import GlobalSwitcher from '../../components/UI/GlobalSwitcher.astro';
import data from '../../data/en.json';
---

<DesignLayout title="Oscar Pozo Creative | Senior Graphic Designer" description={data.hero.desc} lang="en">
	
	<!-- TU HEADER EXACTO E IDÉNTICO SIN NINGUNA ALTERACIÓN -->
	<nav id="main-nav" style="display: flex !important; align-items: flex-start !important; padding: 25px 40px !important; height: 120px !important; box-sizing: border-box !important;">
        <div class="hud-left">
            <a href="#" class="hud-logo nav-link">
                <img src="/assets/favicon-light.png" alt="Oscar Pozo Logo" style="width: 35px; height: 35px; transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), filter 0.3s; filter: var(--nav-logo-filter); transform: translateZ(0);">
            </a>
            <GlobalSwitcher />
        </div>
        <div class="hud-right" style="display: flex !important; align-items: center !important; gap: 0px !important;">
            <div class="hud-status" style="text-align: right !important; flex-shrink: 0 !important; margin-right: 0px !important;">
                <strong>Senior Graphic Designer</strong><br>
                <span>Dominican Republic</span>
            </div>
            
            <!-- LÍNEA DE DIVISIÓN EDITORIAL MAESTRA (1:1 COORDENADA FOTOGRAFÍA) -->
            <div style="width: 1px; height: 24px; background: rgba(255, 255, 255, 0.1); margin-left: 25px !important; margin-right: 24px !important; align-self: center; flex-shrink: 0;"></div>

            <!-- CONTROLES DE IDIOMA ALINEADOS -->
            <div class="hud-controls flex gap-4 text-xs font-mono tracking-widest text-[var(--text)]" style="pointer-events: auto; align-items: center; flex-shrink: 0;">
                <a href="/" class="ctrl-btn">ES</a>
                <span class="opacity-20">/</span>
                <a href="/en/" class="ctrl-btn active">EN</a>
            </div>

            <!-- CTA CON AJUSTE DE MARGEN COHESIVO -->
            <a href="#contacto" class="btn-cta-nav magnetic-target hover-target" style="margin-left: 25px !important; flex-shrink: 0 !important;">{data.nav.cta}</a>
        </div>
    </nav>

	<section class="z-wrapper">
		<div class="z-layer layer-hero">
			<h1 class="hero-title">
                <span class="reveal-wrap"><span class="reveal-text">STRATEGIC</span></span><br>
                <span class="reveal-wrap"><span class="reveal-text glow-text">CREATIVITY.</span></span>
            </h1>
			<p class="hero-desc" style="opacity:0; transform:translateY(20px);">{data.hero.desc}</p>
            <div class="scroll-indicator"><div class="scroll-line"></div><span>{data.hero.scroll}</span></div>
		</div>

        {data.zProjects.map((project) => (
            <div class="z-layer">
                <article class="monolith hover-target lb-trigger tilt-target skew-target" tabindex="0" role="button" aria-label="Open project" data-title={project.title}>
                    <div class="m-img-wrap"><img src={project.img} alt={project.title} class="m-img target-img" loading="lazy" decoding="async"></div>
                    <div class="m-content">
                        <div class="m-meta"><span>{project.meta1}</span><span>{project.meta2}</span></div>
                        <h2 class="m-title">{project.title}</h2>
                        <div class="project-details" style="display:none;">
                            <p class="m-summary">{project.summary}</p>
                            <div class="m-item"><strong>Challenge</strong><p>{project.reto}</p></div>
                            <div class="m-item"><strong>Approach</strong><p>{project.enfoque}</p></div>
                            <div class="m-item"><strong>Result</strong><p>{project.resultado}</p></div>
                        </div>
                    </div>
                </article>
            </div>
        ))}
	</section>

    <section class="h-wrapper" id="casos">
        <div class="h-container">
            {data.hProjects.map((project) => (
                <div class="h-panel">
                    <article class="h-card hover-target lb-trigger tilt-target skew-target" tabindex="0" role="button" aria-label="Open project" data-title={project.title}>
                        <div class="card-glare"></div>
                        <div class="h-img-wrap"><img src={project.img} alt={project.title} class="h-img target-img parallax-img" loading="lazy" decoding="async"></div>
                        <div class="h-info">
                            <div class="m-meta"><span>{project.meta1}</span><span>{project.meta2}</span></div>
                            <h3>{project.title}</h3>
                            <div class="project-details" style="display:none;">
                                <p class="m-summary">{project.summary}</p>
                                <div class="m-item"><strong>Challenge</strong><p>{project.reto}</p></div>
                                <div class="m-item"><strong>Approach</strong><p>{project.enfoque}</p></div>
                                <div class="m-item"><strong>Result</strong><p>{project.resultado}</p></div>
                            </div>
                        </div>
                    </article>
                </div>
            ))}
        </div>
    </section>

    <section class="reels-wrapper" id="audiovisual">
        <div class="section-header"><h2 class="has-reveal">{data.reelsTitle}</h2></div>
        <div class="reels-track">
            {data.reels.map((reel) => (
                <article class="reel-item hover-target lb-trigger" tabindex="0" role="button" aria-label="Open project" data-title={reel.title} data-video-full={reel.videoFull}>
                    <img src={reel.thumb} alt={reel.title} class="reel-bg target-img" loading="lazy" decoding="async">
                    <video class="hover-video" src={reel.videoHover} muted loop playsinline preload="metadata"></video>
                    <div class="reel-overlay"></div><div class="reel-glare"></div>
                    <div class="video-badge"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg><span>Play</span></div>
                    <div class="reel-info"><span>{reel.meta}</span><h4>{reel.title}</h4></div>
                    <div class="project-details" style="display:none;"><p class="m-summary">{reel.summary}</p></div>
                </article>
            ))}
        </div>
    </section>

    <section class="vault-wrapper" id="mas-trabajo">
        <div class="section-header"><h2 class="has-reveal">{data.vaultTitle}</h2></div>
        <div class="vault-grid">
            {data.vault.map((item) => (
                <article class="v-item hover-target lb-trigger tilt-target skew-target" tabindex="0" role="button" aria-label="Open project" data-title={item.title}>
                    <img src={item.img} alt={item.title} class="v-bg target-img" loading="lazy" decoding="async">
                    <div class="v-info"><span>{item.meta}</span><h4>{item.title}</h4></div>
                    <div class="project-details" style="display:none;">
                        <p class="m-summary">{item.summary}</p>
                        <div class="m-item"><strong>Challenge</strong><p>{item.reto}</p></div>
                        <div class="m-item"><strong>Approach</strong><p>{item.enfoque}</p></div>
                        <div class="m-item"><strong>Result</strong><p>{item.resultado}</p></div>
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class="process-wrapper" id="metodo">
        <div class="section-header"><h2 class="has-reveal">{data.processTitle}</h2></div>
        <div class="process-grid">
            {data.process.map((p) => (
                <div class="p-card hover-target tilt-target skew-target">
                    <span class="p-num">{p.num}</span>
                    <h3 class="p-title">{p.title}</h3>
                    <p class="p-desc">{p.desc}</p>
                </div>
            ))}
        </div>
    </section>

    <section class="profile-wrapper" id="perfil">
        <div class="profile-grid">
            <div class="profile-main">
                <span class="t-eyebrow">{data.profile.eyebrow}</span>
                <h2 class="t-title has-reveal">{data.profile.title}</h2>
                <div class="profile-bio-wrap" style="display: flex; gap: 30px; align-items: flex-start; margin-bottom: 30px; flex-wrap: wrap;">
                    <div class="profile-avatar tilt-target" style="flex: 0 0 220px; height: 250px; border-radius: 10px; overflow: hidden; position: relative; border: 1px solid var(--border); background: #050505;">
                        <img src="/assets/oscar-profile.webp" alt="Oscar Pozo" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                        <div style="position: absolute; inset: 0; background: linear-gradient(to top, #020202 0%, transparent 20%); pointer-events: none;"></div>
                    </div>
                    <div style="flex: 1; min-width: 250px;">
                        <p>{data.profile.p1}</p>
                        <p>{data.profile.p2}</p>
                    </div>
                </div>
                <p>{data.profile.p3}</p>
            </div>
            <div class="profile-sidebar tilt-target">
                <span class="t-eyebrow">{data.profile.focusEyebrow}</span>
                <div class="t-focus-list">
                    {data.profile.focusList.map((f) => (
                        <div class="t-focus-item"><strong>{f.title}</strong><span>{f.desc}</span></div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="terminal-wrapper" id="contacto">
        <div class="terminal-grid">
            <div class="t-panel tilt-target">
                <span class="t-eyebrow">{data.contact.eyebrow}</span>
                <h2 class="t-title has-reveal">{data.contact.title}</h2>
                <p class="t-desc">{data.contact.desc}</p>
            </div>
            <div class="t-panel tilt-target">
                <div class="t-meta-grid">
                    <div class="t-meta-box"><strong>{data.contact.locLabel}</strong><span>{data.contact.locVal}</span></div>
                    <div class="t-meta-box"><strong>{data.contact.specLabel}</strong><span>{data.contact.specVal}</span></div>
                    <div class="t-meta-box"><strong>{data.contact.dispLabel}</strong><span>{data.contact.dispVal}</span></div>
                </div>
                <div class="t-actions">
                    {data.contact.links.map((link) => (
                        <a href={link.url} target="_blank" rel="noreferrer" class={`btn-outline hover-target magnetic-target ${link.solid ? 'btn-solid' : ''}`}>{link.label}</a>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="footer-container footer-grid">
            <div><a href="#" class="footer-logo-wrap hover-target magnetic-target"><img src="/assets/logo.png" alt="Oscar Pozo Creativo" class="footer-logo" loading="lazy" decoding="async"></a></div>
            <div class="footer-links">
                <button type="button" id="backToTop" class="hover-target magnetic-target">{data.footer.backToTop}</button>
                <a href="#casos" class="hover-target nav-link magnetic-target">{data.footer.port}</a>
                <a href="#metodo" class="hover-target nav-link magnetic-target">{data.footer.proc}</a>
            </div>
            <div><span>{data.footer.rights}</span></div>
        </div>
    </footer>
</DesignLayout>

<style is:global>
    /* --- BLINDAJE RESPONSIVE PREMIUM PARA EL HERO DE DISEÑO --- */
    .photo-env .layer-hero,
    .layer-hero {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        width: 100vw !important;
        box-sizing: border-box !important;
    }

    .layer-hero .hero-desc {
        font-family: 'Satoshi', sans-serif !important;
        font-size: clamp(0.95rem, 1.2vw, 1.15rem) !important;
        line-height: 1.6 !important;
        color: #888888 !important;
        max-width: 600px !important;
        width: 90% !important;
        margin: 0 auto !important;
        text-align: center !important;
        box-sizing: border-box !important;
    }

    /* --- ALINEACIÓN DE COLOR ACTIVO DE IDIOMA EN DISEÑO --- */
    #main-nav .ctrl-btn.active {
        color: #40B5E5 !important;
        opacity: 1 !important;
    }
    #main-nav .ctrl-btn:hover {
        opacity: 1 !important;
    }
</style>

<!-- INJECTOR DINÁMICO DE RESPONSIVE (Garantiza adaptabilidad móvil sobre tus estilos inline intactos) -->
<script is:inline>
    (function() {
        function adjustHeader() {
            var nav = document.getElementById('main-nav');
            if (!nav) return;
            
            var status = nav.querySelector('.hud-status');
            var divider = nav.querySelector('.hud-right > div[style*="width: 1px"]');
            var controls = nav.querySelector('.hud-controls');
            var cta = nav.querySelector('.btn-cta-nav');
            var logoImg = nav.querySelector('.hud-logo img');
            
            if (window.innerWidth <= 1024) {
                // Móvil y Tablets
                nav.style.setProperty('display', 'flex', 'important');
                nav.style.setProperty('align-items', 'center', 'important');
                nav.style.setProperty('padding', '15px 15px', 'important');
                nav.style.setProperty('height', '80px', 'important');
                
                if (status) status.style.setProperty('display', 'none', 'important');
                if (divider) divider.style.setProperty('display', 'none', 'important');
                if (controls) {
                    controls.style.setProperty('padding-left', '0', 'important');
                    controls.style.setProperty('gap', '8px', 'important');
                }
                if (cta) {
                    cta.style.setProperty('margin-left', '0px', 'important');
                    cta.style.setProperty('padding', '8px 14px', 'important');
                    cta.style.setProperty('font-size', '8.5px', 'important');
                }
                if (logoImg) {
                    logoImg.style.setProperty('width', '30px', 'important');
                    logoImg.style.setProperty('height', '30px', 'important');
                }
            } else {
                // Restaurar tus estilos de escritorio exactos
                nav.style.setProperty('display', 'flex', 'important');
                nav.style.setProperty('align-items', 'flex-start', 'important');
                nav.style.setProperty('padding', '25px 40px', 'important');
                nav.style.setProperty('height', '120px', 'important');
                
                if (status) status.style.setProperty('display', 'block', 'important');
                if (divider) {
                    divider.style.setProperty('display', 'block', 'important');
                    divider.style.setProperty('width', '1px', 'important');
                    divider.style.setProperty('height', '24px', 'important');
                    divider.style.setProperty('background', 'rgba(255, 255, 255, 0.1)', 'important');
                    divider.style.setProperty('margin-left', '25px', 'important');
                    divider.style.setProperty('margin-right', '24px', 'important');
                }
                if (controls) {
                    controls.style.removeProperty('padding-left');
                    controls.style.removeProperty('gap');
                }
                if (cta) {
                    cta.style.setProperty('margin-left', '25px', 'important');
                    cta.style.removeProperty('padding');
                    cta.style.removeProperty('font-size');
                }
                if (logoImg) {
                    logoImg.style.setProperty('width', '35px', 'important');
                    logoImg.style.setProperty('height', '35px', 'important');
                }
            }
        }
        
        window.addEventListener('resize', adjustHeader);
        window.addEventListener('DOMContentLoaded', adjustHeader);
        adjustHeader();
    })();
    
</script>