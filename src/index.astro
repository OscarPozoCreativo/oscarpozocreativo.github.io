    .t-focus-item span { color: var(--muted); font-size: 0.9rem; line-height: 1.6; display: block; }
    .terminal-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .t-panel { display: flex; flex-direction: column; justify-content: center; }
    .t-eyebrow { font-family: var(--font-display); font-weight: 700; font-size: 8px; color: var(--accent); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 20px; display: block; }
    .t-title { font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.3; margin-bottom: 20px; text-transform: uppercase; font-weight: 700; }
    .t-desc { color: var(--muted); line-height: 1.7; font-size: 1rem; margin-bottom: 30px; }
    .t-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
    .t-meta-box { padding-bottom: 15px; border-bottom: 1px solid var(--border); }
    .t-meta-box strong { font-family: var(--font-display); font-weight: 700; font-size: 8px; color: var(--accent); text-transform: uppercase; display: block; margin-bottom: 5px; letter-spacing: 1px;}
    .t-meta-box span, .t-meta-box a { color: var(--text); font-size: 0.9rem; text-decoration: none; line-height: 1.5; pointer-events: auto; display: inline-block; }
