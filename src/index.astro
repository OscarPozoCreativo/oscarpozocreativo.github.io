---
interface Props {
	title: string;
	description: string;
	lang: string;
}

const { title, description, lang } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/assets/favicon-light.png" />
		
		<link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" rel="stylesheet">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
        <div id="system-init"><div class="loader-terminal"><span>ESTABLECIENDO CONEXIÓN...</span><span class="loader-pct" id="loader-pct">[000%]</span></div></div>
        <div id="progress-bar"></div>
        
		<slot />

        <!-- LIGHTBOX GLOBAL -->
        <div class="lightbox" id="lightbox">
            <div class="lightbox__ambient" id="lb-ambient"></div>
            <button class="lb-nav lb-prev hover-target magnetic-target" id="lb-prev"><svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg></button>
            <button class="lb-nav lb-next hover-target magnetic-target" id="lb-next"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></button>
            <button class="lb-close hover-target magnetic-target" id="lb-close">X</button>
            <div class="lightbox__dialog">
                <div class="lightbox__main" id="lb-media-container"></div>
                <div class="lightbox__side"><h3 id="lb-title"></h3><div id="lb-desc"></div></div>
            </div>
        </div>

		<script>
			import Lenis from '@studio-freight/lenis';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

            // 1. Inicializar Lenis
			const lenis = new Lenis({ duration: 1.2, smoothWheel: true });
			lenis.on('scroll', ScrollTrigger.update);
            lenis.on('scroll', (e) => {
                const progress = (e.animatedScroll / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
                const pb = document.getElementById('progress-bar');
                if(pb) pb.style.width = `${progress}%`;
            });
			gsap.ticker.add((time) => { lenis.raf(time * 1000); });
			gsap.ticker.lagSmoothing(0, 0);

            // 2. Lógica de Preloader y Animaciones Iniciales (CORREGIDA PARA ASTRO)
            function initApp() {
                let pct = 0;
                const pctEl = document.getElementById('loader-pct');
                const interval = setInterval(() => {
                    pct += 4;
                    if(pctEl) pctEl.innerText = `[${pct.toString().padStart(3, '0')}%]`;
                    if(pct >= 100) {
                        clearInterval(interval);
                        gsap.to('#system-init', { 
                            clipPath: 'polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)', 
                            duration: 1.2, 
                            ease: "expo.inOut", 
                            onComplete: () => {
                                const sysInit = document.getElementById('system-init');
                                if(sysInit) sysInit.style.display = 'none';
                                
                                gsap.to('.hero-title .reveal-text', { y: '0%', opacity: 1, filter: "blur(0px)", duration: 1, ease: 'power3.out', stagger: 0.1 });
                                gsap.to('.hero-desc', { y: 0, opacity: 1, duration: 1, delay: 0.3 });
                                gsap.to('.scroll-indicator', { opacity: 1, duration: 1, delay: 0.6 });
                                
                                gsap.fromTo('.v-item', { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".vault-grid", start: "top 85%" } });
                                gsap.fromTo('.p-card', { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: "power3.out", scrollTrigger: { trigger: ".process-grid", start: "top 85%" } });
                                gsap.fromTo('.profile-main p', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".profile-main", start: "top 80%" } });
                                gsap.fromTo('.profile-sidebar', { x: 50, opacity: 0 }, { x: 0, opacity: 1, duration: 1, ease: "power3.out", scrollTrigger: { trigger: ".profile-grid", start: "top 80%" } });
                                gsap.fromTo('.t-focus-item', { x: 20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".t-focus-list", start: "top 85%" } });
                                gsap.fromTo('.t-panel > *', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".terminal-grid", start: "top 85%" } });

                                if(window.innerWidth <= 1024) {
                                    gsap.utils.toArray('.monolith, .h-card, .reel-item').forEach(el => {
                                        gsap.fromTo(el, { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 90%" } });
                                    });
                                }
                            }
                        });
                    }
                }, 15);
            }

            // Detectar si Astro ya cargó la página antes de que el script se ejecute
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                setTimeout(initApp, 50);
            } else {
                window.addEventListener('DOMContentLoaded', initApp);
            }

            // 3. Lógica de Animaciones Z y H
            let mm = gsap.matchMedia();
            mm.add("(min-width: 1025px)", () => {
                const zLayers = gsap.utils.toArray('.z-layer'); 
                if(zLayers.length) {
                    gsap.set(zLayers.slice(1), { scale: 0.1, autoAlpha: 0, filter: "blur(5px)" });
                    let zTl = gsap.timeline({ scrollTrigger: { trigger: ".z-wrapper", start: "top top", end: "+=400%", pin: true, scrub: 0.5 } });
                    zTl.to('.layer-hero', { autoAlpha: 0, scale: 0.8, filter: "blur(5px)", duration: 1 }, 0);
                    zLayers.forEach((layer, i) => {
                        if (i !== 0) { 
                            let start = (i * 3) - 2; 
                            zTl.fromTo(layer, { scale: 0.1, autoAlpha: 0, filter: "blur(5px)" }, { scale: 1, autoAlpha: 1, filter: "blur(0px)", duration: 1 }, start); 
                            zTl.to(layer, { scale: 1, duration: 2 }, start + 1);
                            if (i !== zLayers.length - 1) { zTl.to(layer, { scale: 5, autoAlpha: 0, filter: "blur(5px)", duration: 1 }, start + 3); }
                        }
                    });
                }

                const hPanels = gsap.utils.toArray('.h-panel');
                if(hPanels.length) {
                    let hTween = gsap.to(hPanels, { 
                        xPercent: -100 * (hPanels.length - 1), ease: "none", 
                        scrollTrigger: { trigger: ".h-wrapper", pin: true, scrub: 1, end: () => "+=" + (document.querySelector(".h-container").offsetWidth) } 
                    });
                    gsap.utils.toArray('.h-card').forEach((card, i) => {
                        let tl3D = gsap.timeline({ scrollTrigger: { trigger: card.closest('.h-panel'), containerAnimation: hTween, start: "left 100%", end: "right 0%", scrub: true } });
                        tl3D.fromTo(card, { rotationY: 45, rotationX: 5, z: -800, scale: 0.6, opacity: 0, filter: "brightness(0.5) blur(5px)" }, { rotationY: 0, rotationX: 0, z: 0, scale: 1, opacity: 1, filter: "brightness(1) blur(0px)", duration: 1, ease: "sine.inOut" }).to(card, { rotationY: -45, rotationX: 5, z: -800, scale: 0.6, opacity: 0, filter: "brightness(0.5) blur(5px)", duration: 1, ease: "sine.inOut" });
                    });
                }

                const reelsTrack = document.querySelector('.reels-track');
                if(reelsTrack) {
                    let getScrollAmount = () => reelsTrack.scrollWidth - window.innerWidth + (window.innerWidth * 0.05);
                    gsap.to(reelsTrack, { x: () => -getScrollAmount(), ease: "none", scrollTrigger: { trigger: ".reels-wrapper", pin: true, scrub: 1, end: () => "+=" + (reelsTrack.scrollWidth) } });
                }
            });

            // 4. Lightbox Logic
            const lightbox = document.getElementById('lightbox'); 
            const lbMediaContainer = document.getElementById('lb-media-container');
            const lbAmbient = document.getElementById('lb-ambient');
            let currentLbIndex = 0;
            const allLbTriggers = Array.from(document.querySelectorAll('.lb-trigger'));

            function populateLightbox(index) {
                const item = allLbTriggers[index];
                const title = item.getAttribute('data-title');
                const videoFullSrc = item.getAttribute('data-video-full');
                const imgNode = item.querySelector('img');
                let imgSrc = imgNode ? imgNode.getAttribute('src') : '';
                
                document.getElementById('lb-title').textContent = title; 
                const projectDetails = item.querySelector('.project-details');
                if(projectDetails) { document.getElementById('lb-desc').innerHTML = projectDetails.innerHTML; } 
                
                if(imgSrc) { lbAmbient.style.backgroundImage = `url('${imgSrc}')`; } 
                else { lbAmbient.style.backgroundImage = 'none'; }

                lbMediaContainer.innerHTML = ''; let mediaEl;
                if (videoFullSrc) {
                    mediaEl = document.createElement('video'); mediaEl.src = videoFullSrc; mediaEl.className = 'lightbox__img'; mediaEl.autoplay = true; mediaEl.loop = true; mediaEl.controls = true; mediaEl.playsInline = true;
                } else {
                    mediaEl = document.createElement('img'); mediaEl.src = imgSrc; mediaEl.className = 'lightbox__img'; mediaEl.alt = title;
                }
                lbMediaContainer.appendChild(mediaEl);
            }

            function openLightbox(index) {
                currentLbIndex = index; populateLightbox(index);
                lightbox.style.display = 'flex'; lenis.stop();
                gsap.to('#main-nav', { opacity: 0, duration: 0.3 });
                gsap.fromTo(lightbox, { opacity: 0 }, { opacity: 1, duration: 0.4 });
                gsap.fromTo('.lightbox__dialog', { scale: 0.95, y: 20, opacity: 0 }, { scale: 1, y: 0, opacity: 1, duration: 0.6, ease: "expo.out" });
            }

            function changeLightboxItem(direction) {
                currentLbIndex = (currentLbIndex + direction + allLbTriggers.length) % allLbTriggers.length;
                gsap.to(['#lb-media-container', '.lightbox__side'], {
                    x: direction * -30, opacity: 0, duration: 0.3,
                    onComplete: () => {
                        populateLightbox(currentLbIndex);
                        gsap.fromTo(['#lb-media-container', '.lightbox__side'], { x: direction * 30, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "expo.out" });
                    }
                });
            }

            allLbTriggers.forEach((item, index) => { item.addEventListener('click', () => openLightbox(index)); });
            document.getElementById('lb-prev').addEventListener('click', (e) => { e.stopPropagation(); changeLightboxItem(-1); });
            document.getElementById('lb-next').addEventListener('click', (e) => { e.stopPropagation(); changeLightboxItem(1); });
            document.getElementById('lb-close').addEventListener('click', () => {
                gsap.to('#main-nav', { opacity: 1, duration: 0.4 });
                gsap.to(lightbox, { opacity: 0, duration: 0.3, onComplete: () => { lightbox.style.display = 'none'; lbMediaContainer.innerHTML = ''; lenis.start(); }});
            });

            // 5. Header Invert
            window.addEventListener('scroll', () => {
                let invert = false;
                document.querySelectorAll('.h-wrapper').forEach(sec => {
                    const rect = sec.getBoundingClientRect();
                    if(rect.top <= 40 && rect.bottom >= 40) invert = true;
                });
                if(invert) document.getElementById('main-nav').classList.add('nav-inverted');
                else document.getElementById('main-nav').classList.remove('nav-inverted');
            }, { passive: true });

            // 6. Footer Pulse
            ScrollTrigger.create({
                trigger: ".site-footer", start: "top 90%",
                onEnter: () => { gsap.to('.btn-cta-nav', { scale: 1.1, boxShadow: "0 0 20px rgba(255,255,255,0.4)", duration: 0.4, yoyo: true, repeat: 1, ease: "power2.out" }); }
            });

            // 7. Back to top
            document.getElementById('backToTop').addEventListener('click', () => { lenis.scrollTo(0, { duration: 1.5 }); });
            document.querySelectorAll('.nav-link').forEach(anchor => { anchor.addEventListener('click', function(e) { e.preventDefault(); const targetEl = document.querySelector(this.getAttribute('href')); if(targetEl) lenis.scrollTo(targetEl, { offset: 0, duration: 1.5 }); }); });

            // 8. Hover Videos
            if(window.innerWidth > 768) {
                document.querySelectorAll('.reel-item').forEach(item => {
                    const hoverVid = item.querySelector('.hover-video'); 
                    item.addEventListener('mouseenter', () => { if(hoverVid) { hoverVid.currentTime = 0; hoverVid.play(); gsap.to(hoverVid, {opacity: 1, duration: 0.4}); } });
                    item.addEventListener('mouseleave', () => { if(hoverVid) { gsap.to(hoverVid, {opacity: 0, duration: 0.3, onComplete: () => hoverVid.pause()}); } });
                });
            }
		</script>
	</body>
</html>

<style is:global>
    :root {
        --bg: #020202; --surface: transparent; --text: #ffffff; 
        --accent: #40B5E5; --accent-dark: #0077b6;
        --muted: #888888; --border: rgba(255,255,255,0.05);
        --modal-bg: rgba(0,0,0,0.95); --modal-panel: #0a0a0a;
        --font-display: 'Syncopate', sans-serif; --font-body: 'Satoshi', sans-serif; --font-mono: 'JetBrains Mono', monospace;
        --nav-text: #ffffff; --nav-logo-filter: none; --cta-bg: #ffffff; --cta-text: #000000;
    }
    [data-theme="light"], .nav-inverted {
        --bg: #f4f4f5; --surface: #ffffff; --text: #050505; 
        --accent: #40B5E5; --accent-dark: #005f8e;
        --muted: #666666; --border: rgba(0,0,0,0.1);
        --modal-bg: rgba(244,244,245,0.95); --modal-panel: #ffffff;
        --nav-text: #050505; --nav-logo-filter: invert(1); --cta-bg: #050505; --cta-text: #ffffff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: var(--bg); color: var(--text); font-family: var(--font-body); overflow-x: hidden; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; transition: background-color 0.5s, color 0.5s; }
    ::-webkit-scrollbar { width: 0px; background: transparent; }
    ::selection { background: var(--accent); color: #fff; }
    *:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); border-radius: 4px; }
    .monolith:focus-visible, .h-card:focus-visible, .v-item:focus-visible, .reel-item:focus-visible { box-shadow: 0 0 0 4px var(--bg), 0 0 0 8px var(--accent); border-radius: 20px; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
    #progress-bar { position: fixed; top: 0; left: 0; height: 3px; background: var(--accent); z-index: 1000000; width: 0%; pointer-events: none; transform: translateZ(0); will-change: width; }
    #system-init { position: fixed; inset: 0; background: var(--bg); z-index: 999999; display: flex; align-items: center; justify-content: center; flex-direction: column; will-change: clip-path, opacity, visibility; clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%); }
    .loader-terminal { font-family: var(--font-mono); font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 30px; text-align: center; }
    .loader-pct { color: var(--accent); font-size: 24px; font-weight: 700; display: block; margin-top: 10px; font-variant-numeric: tabular-nums; }
    .has-reveal { opacity: 0; } 
    .reveal-wrap { overflow: visible !important; display: inline-block; vertical-align: top; position: relative; }
    .reveal-text { display: inline-block; transform: translateY(30px); opacity: 0; position: relative; z-index: 2; padding: 10px 20px; margin: -10px -20px; will-change: transform, opacity; }
    .glow-text { background: linear-gradient(270deg, var(--accent), #00d4ff, var(--accent)); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: flowPlasma 4s ease-in-out infinite alternate; text-shadow: 0 0 20px rgba(64,181,229,0.3), 0 0 40px rgba(0,119,182,0.2); transform: translateZ(0); }
    @keyframes flowPlasma { 0%{background-position:0% 50%} 100%{background-position:100% 50%} }
    nav { position: fixed; top: 0; width: 100%; padding: clamp(15px, 2vh, 20px) clamp(20px, 4vw, 40px); display: flex; justify-content: space-between; align-items: flex-start; z-index: 100; pointer-events: none; background: transparent !important; border: none !important; height: 100px; }
    nav::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: transparent !important; mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 60%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,160%, rgba(0,0,0,0) 100%); }
    .hud-left { display: flex; flex-direction: row; align-items: center; gap: 40px; pointer-events: auto; }
    .hud-logo { display: flex; align-items: center; background: transparent; padding: 0; font-family: var(--font-display); font-weight: 700; color: var(--nav-text); text-decoration: none; font-size: 1.5rem; }
    .hud-controls { display: flex; gap: 20px; align-items: center; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; height: 40px; }
    .ctrl-btn { background: transparent; border: none; color: var(--nav-text); padding: 0; transition: opacity 0.3s, color 0.3s; pointer-events: auto; font-weight: 700; letter-spacing: 1px; opacity: 0.7; cursor: pointer; text-decoration: none; }
    .ctrl-btn:hover, .ctrl-btn.active { opacity: 1; }
    .hud-right { display: flex; align-items: center; gap: 25px; pointer-events: auto; }
    .hud-status { text-align: right; font-family: var(--font-display); font-size: 8px; color: var(--nav-text); opacity: 0.7; line-height: 1.8; text-transform: uppercase; letter-spacing: 1px; background: transparent; padding: 0; border: none; transition: color 0.3s; }
    .hud-status strong { color: var(--nav-text); font-size: 10px; font-weight: 700; opacity: 1; }
    .btn-cta-nav { height: 38px; padding: 0 24px; background: var(--cta-bg); color: var(--cta-text); border-radius: 100px; font-family: var(--font-display); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: transform 0.3s, background 0.3s, color 0.3s, box-shadow 0.3s; pointer-events: auto; border: none; transform: translateZ(0); }
    .btn-cta-nav:hover { transform: scale(1.05) translateZ(0); }
    .z-wrapper, .reels-wrapper, .vault-wrapper, .process-wrapper, .profile-wrapper, .terminal-wrapper, .site-footer { background: transparent !important; position: relative; z-index: 10; }
    .z-wrapper { width: 100vw; height: 100vh; position: relative; overflow: hidden; pointer-events: none; }
    .z-layer { position: absolute; inset: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; transform: translate3d(0,0,0); backface-visibility: hidden; pointer-events: none; will-change: transform, filter, opacity; }
    .z-layer:not(.layer-hero) { visibility: hidden; opacity: 0; }
    .layer-hero { flex-direction: column; text-align: center; pointer-events: auto; position: relative; justify-content: center; margin-top: -5vh; }
    .hero-title { font-family: var(--font-display); font-size: clamp(2.5rem, 8vw, 9rem); font-weight: 700; line-height: 0.85; text-transform: uppercase; letter-spacing: -2px; margin-bottom: 20px; }
    .hero-desc { max-width: 650px; font-size: clamp(0.95rem, 1.2vw, 1.1rem); line-height: 1.6; color: rgba(255,255,255,0.7); font-weight: 400; padding: 0 20px;}
    .scroll-indicator { position: absolute; bottom: 8vh; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 12px; pointer-events: none; opacity: 0; }
    .scroll-line { width: 1px; height: 40px; background: rgba(255,255,255,0.1); position: relative; overflow: hidden; }
    .scroll-line::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 50%; background: var(--accent); animation: scrollDrop 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
    .scroll-indicator span { font-family: var(--font-display); font-size: 7px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 3px; }
    .monolith { width: 85vw; max-width: 1200px; height: clamp(350px, 60vh, 600px); background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.01) 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1); pointer-events: auto; transition: box-shadow 0.4s, border 0.4s; transform: translate3d(0,0,0); backface-visibility: hidden; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); will-change: transform, opacity; cursor: pointer; }
    .monolith:hover { box-shadow: 0 40px 80px rgba(0,0,0,0.8), 0 0 40px rgba(64,181,229,0.15); border-color: rgba(255,255,255,0.2); }
    .m-img-wrap, .h-img-wrap { position: relative; overflow: hidden; background: transparent !important; transform: translateZ(0); }
    .target-img, .h-img, .v-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; transform: scale(1) translate3d(0,0,0); transition: filter 0.8s cubic-bezier(0.19, 1, 0.22, 1), transform 1.2s cubic-bezier(0.19, 1, 0.22, 1); filter: grayscale(0.8) brightness(0.8); backface-visibility: hidden; will-change: transform; }
    @media (min-width: 1025px) { .monolith:hover .target-img, .h-card:hover .target-img, .v-item:hover .v-bg, .reel-item:hover .target-img { filter: grayscale(0) brightness(1); transform: scale(1.03) translate3d(0,0,0); } }
    .m-content { padding: clamp(15px, 2.5vw, 30px); display: flex; flex-direction: column; justify-content: center; overflow-y: auto;}
    .m-content::-webkit-scrollbar { width: 0px; }
    .m-meta span { padding: 4px 10px; border: 1px solid var(--muted); border-radius: 100px; font-family: var(--font-display); font-size: clamp(6px, 0.8vw, 8px); text-transform: uppercase; color: var(--text); margin-right: 8px; font-weight: 700; letter-spacing: 1px; display: inline-block; margin-bottom: 5px; }
    .m-title { font-family: var(--font-display); font-size: clamp(1rem, 1.8vw, 1.4rem); line-height: 1.3; margin: clamp(10px, 2vh, 20px) 0 clamp(10px, 1.5vh, 15px); font-weight: 700; text-transform: uppercase; }
    .project-details { display: flex; flex-direction: column; }
    .m-summary { color: var(--muted); margin-bottom: clamp(15px, 2vh, 20px); font-size: clamp(0.85rem, 1vw, 1rem); line-height: 1.5; padding-bottom: clamp(10px, 1.5vh, 15px); border-bottom: 1px solid var(--border); }
    .m-item { border-left: 2px solid var(--accent); padding-left: 12px; margin-bottom: clamp(10px, 1.5vh, 15px); }
    .m-item strong { display: block; font-family: var(--font-display); font-size: 7px; font-weight: 700; letter-spacing: 2px; color: var(--accent); margin-bottom: 4px; text-transform: uppercase; }
    .m-item p { font-size: clamp(0.8rem, 0.9vw, 0.95rem); line-height: 1.5; color: var(--muted); }
