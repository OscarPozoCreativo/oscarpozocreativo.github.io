    #system-init { position: fixed; inset: 0; background: var(--bg); z-index: 999999; display: flex; align-items: center; justify-content: center; flex-direction: column; will-change: clip-path, opacity, visibility; clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%); }
    .loader-terminal { font-family: var(--font-mono); font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 30px; text-align: center; }
    .loader-pct { color: var(--accent); font-size: 24px; font-weight: 700; display: block; margin-top: 10px; font-variant-numeric: tabular-nums; }
    .has-reveal { opacity: 0; } 
    .reveal-wrap { overflow: visible !important; display: inline-block; vertical-align: top; position: relative; }
    .reveal-text { display: inline-block; transform: translateY(30px); opacity: 0; position: relative; z-index: 2; padding: 10px 20px; margin: -10px -20px; will-change: transform, opacity; }
    .glow-text { background: linear-gradient(270deg, var(--accent), #00d4ff, var(--accent)); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: flowPlasma 4s ease-in-out infinite alternate; text-shadow: 0 0 20px rgba(64,181,229,0.3), 0 0 40px rgba(0,119,182,0.2); transform: translateZ(0); }
    @keyframes flowPlasma { 0%{background-position:0% 50%} 100%{background-position:100% 50%} }
    
    nav { position: fixed; top: 0; width: 100%; padding: clamp(15px, 2vh, 20px) clamp(20px, 4vw, 40px); display: flex; justify-content: space-between; align-items: flex-start; z-index: 100; pointer-events: none; background: transparent !important; border: none !important; height: 100px; }
    nav::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: transparent !important; mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 60%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 60%, rgba(0,0,0,0) 100%); }
    .hud-left { display: flex; flex-direction: row; align-items: center; gap: 40px; pointer-events: auto; }
    .hud-logo { display: flex; align-items: center; background: transparent; padding: 0; font-family: var(--font-display); font-weight: 700; color: var(--nav-text); text-decoration: none; font-size: 1.5rem; }
    .hud-controls { display: flex; gap: 20px; align-items: center; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; height: 40px; }
    .ctrl-btn { background: transparent; border: none; color: var(--nav-text); padding: 0; transition: opacity 0.3s, color 0.3s; pointer-events: auto; font-weight: 700; letter-spacing: 1px; opacity: 0.7; cursor: pointer; text-decoration: none; }
    .ctrl-btn:hover, .ctrl-btn.active { opacity: 1; }
    .hud-right { display: flex; align-items: center; gap: 25px; pointer-events: auto; }
    .hud-status { text-align: right; font-family: var(--font-display); font-size: 8px; color: var(--nav-text); opacity: 0.7; line-height: 1.8; text-transform: uppercase; letter-spacing: 1px; background: transparent; padding: 0; border: none; transition: color 0.3s; }
    .hud-status strong { color: var(--nav-text); font-size: 10px; font-weight: 700; opacity: 1; }
    .btn-cta-nav { height: 38px; padding: 0 24px; background: var(--cta-bg); color: var(--cta-text); border-radius: 100px; font-family: var(--font-display); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: transform 0.3s, background 0.3s, color 0.3s, box-shadow 0.3s; pointer-events: auto; border: none; transform: translateZ(0); }
    .btn-cta-nav:hover { transform: scale(1.05) translateZ(0); }
    
    .z-wrapper, .reels-wrapper, .vault-wrapper, .process-wrapper, .profile-wrapper, .terminal-wrapper, .site-footer { background: transparent !important; position: relative; z-index: 10; }
    .z-wrapper { width: 100vw; height: 100vh; position: relative; overflow: hidden; pointer-events: none; }
    .z-layer { position: absolute; inset: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; transform: translate3d(0,0,0); backface-visibility: hidden; pointer-events: none; will-change: transform, filter, opacity; }
    .z-layer:not(.layer-hero) { visibility: hidden; opacity: 0; }
    .layer-hero { flex-direction: column; text-align: center; pointer-events: auto; position: relative; justify-content: center; margin-top: -5vh; }
    .hero-title { font-family: var(--font-display); font-size: clamp(2.5rem, 8vw, 9rem); font-weight: 700; line-height: 0.85; text-transform: uppercase; letter-spacing: -2px; margin-bottom: 20px; }
    .hero-desc { max-width: 650px; font-size: clamp(0.95rem, 1.2vw, 1.1rem); line-height: 1.6; color: rgba(255,255,255,0.7); font-weight: 400; padding: 0 20px;}
    .scroll-indicator { position: absolute; bottom: 8vh; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 12px; pointer-events: none; opacity: 0; }
    .scroll-line { width: 1px; height: 40px; background: rgba(255,255,255,0.1); position: relative; overflow: hidden; }
    .scroll-line::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 50%; background: var(--accent); animation: scrollDrop 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
    .scroll-indicator span { font-family: var(--font-display); font-size: 7px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 3px; }
    
    /* =========================================
       NOOMO AGENCY GLASSMORPHISM EFFECT (DARK)
       ========================================= */
    .monolith { 
        width: 85vw; max-width: 1200px; height: clamp(350px, 60vh, 600px); 
        background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
        border: 1px solid rgba(255,255,255,0.05); 
        border-radius: 24px; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; 
        box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1), inset 0 0 20px rgba(255,255,255,0.02); 
        pointer-events: auto; transition: box-shadow 0.4s, border 0.4s, transform 0.4s; transform: translate3d(0,0,0); backface-visibility: hidden; 
        backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px); will-change: transform, opacity; cursor: pointer;
    }
    .monolith:hover { 
        box-shadow: 0 40px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.2), inset 0 0 20px rgba(255,255,255,0.05); 
        border-color: rgba(255,255,255,0.15); 
    }
    
    .m-img-wrap, .h-img-wrap { position: relative; overflow: hidden; background: transparent !important; transform: translateZ(0); }
    .target-img, .h-img, .v-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; transform: scale(1) translate3d(0,0,0); transition: filter 0.8s cubic-bezier(0.19, 1, 0.22, 1), transform 1.2s cubic-bezier(0.19, 1, 0.22, 1); filter: grayscale(0.8) brightness(0.8); backface-visibility: hidden; will-change: transform; }
    @media (min-width: 1025px) { .monolith:hover .target-img, .h-card:hover .target-img, .v-item:hover .v-bg, .reel-item:hover .target-img { filter: grayscale(0) brightness(1); transform: scale(1.03) translate3d(0,0,0); } }
    
    .m-content { padding: clamp(15px, 2.5vw, 30px); display: flex; flex-direction: column; justify-content: center; overflow-y: auto;}
    .m-content::-webkit-scrollbar { width: 0px; }
    .m-meta span { padding: 4px 10px; border: 1px solid var(--muted); border-radius: 100px; font-family: var(--font-display); font-size: clamp(6px, 0.8vw, 8px); text-transform: uppercase; color: var(--text); margin-right: 8px; font-weight: 700; letter-spacing: 1px; display: inline-block; margin-bottom: 5px; }
    .m-title { font-family: var(--font-display); font-size: clamp(1rem, 1.8vw, 1.4rem); line-height: 1.3; margin: clamp(10px, 2vh, 20px) 0 clamp(10px, 1.5vh, 15px); font-weight: 700; text-transform: uppercase; }
    .project-details { display: flex; flex-direction: column; }
    .m-summary { color: var(--muted); margin-bottom: clamp(15px, 2vh, 20px); font-size: clamp(0.85rem, 1vw, 1rem); line-height: 1.5; padding-bottom: clamp(10px, 1.5vh, 15px); border-bottom: 1px solid var(--border); }
    .m-item { border-left: 2px solid var(--accent); padding-left: 12px; margin-bottom: clamp(10px, 1.5vh, 15px); }
    .m-item strong { display: block; font-family: var(--font-display); font-size: 7px; font-weight: 700; letter-spacing: 2px; color: var(--accent); margin-bottom: 4px; text-transform: uppercase; }
    .m-item p { font-size: clamp(0.8rem, 0.9vw, 0.95rem); line-height: 1.5; color: var(--muted); }
    
    .h-wrapper { width: 100vw; height: 100vh; overflow: hidden; position: relative; z-index: 10; perspective: 2500px; pointer-events: none; background: transparent !important; --text-local: #050505; --muted-local: #555555; --border-local: rgba(0,0,0,0.1); color: var(--text-local); }
    .h-container { display: flex; width: 600vw; height: 100vh; transform-style: preserve-3d; will-change: transform;}
    .h-panel { width: 100vw; height: 100vh; display: flex; align-items: center; justify-content: center; padding: clamp(20px, 4vw, 60px); perspective: 2500px; transform-style: preserve-3d; pointer-events: none;}
    
    /* =========================================
       NOOMO AGENCY GLASSMORPHISM EFFECT (LIGHT)
       ========================================= */
    .h-card { 
        position: relative; width: 100%; max-width: 1200px; height: clamp(350px, 60vh, 600px); 
        display: grid; grid-template-columns: 1fr 1fr; 
        background: linear-gradient(145deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.1) 100%); 
        border: 1px solid rgba(255,255,255,0.6); 
        border-radius: 24px; overflow: hidden; pointer-events: auto; cursor: pointer;
        box-shadow: 0 30px 60px rgba(0,0,0,0.05), inset 0 1px 0 rgba(255,255,255,0.8), inset 0 0 20px rgba(255,255,255,0.2); 
        transition: box-shadow 0.4s, border 0.4s; transform-origin: center center; transform: translate3d(0,0,0); backface-visibility: hidden; will-change: transform, opacity; 
        backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px); color: var(--text-local); 
    }
    .h-card:hover { 
        box-shadow: 0 40px 80px rgba(0,0,0,0.1), inset 0 1px 0 rgba(255,255,255,1), inset 0 0 20px rgba(255,255,255,0.4); 
        border-color: #ffffff; 
    }
    
    .card-glare { position: absolute; inset: 0; z-index: 10; pointer-events: none; mix-blend-mode: overlay; background: linear-gradient(105deg, transparent 20%, rgba(255,255,255,0.8) 25%, transparent 30%); transform: translate3d(-100%, 0, 0); }
    .h-info { padding: clamp(15px, 2.5vw, 30px); display: flex; flex-direction: column; justify-content: center; overflow-y: auto; position: relative; z-index: 5;}
    .h-info::-webkit-scrollbar { width: 0px; }
    .h-info h3 { font-family: var(--font-display); font-size: clamp(1rem, 1.8vw, 1.4rem); margin: clamp(10px, 1.5vh, 15px) 0; line-height: 1.3; font-weight: 700; text-transform: uppercase; color: var(--text-local); }
    .h-info .m-meta span { color: var(--text-local); border-color: var(--border-local); }
    .h-info .m-summary { color: var(--muted-local); border-color: var(--border-local); }
    .h-info .m-item p { color: var(--muted-local); }
    
    .reels-wrapper { min-height: 100vh; height: auto; display: flex; flex-direction: column; justify-content: center; padding: 12vh 0 12vh 5vw; border-top: 1px solid var(--border); overflow: hidden; perspective: 2000px; }
    .reels-wrapper .section-header { text-align: left; margin-bottom: 4vh; padding-right: 5vw; }
    .reels-track { display: flex; gap: clamp(20px, 3vw, 40px); padding: 0 5vw 40px 0; pointer-events: auto; width: max-content; will-change: transform; align-items: center; }
    .reel-item { flex: 0 0 auto; height: clamp(350px, 60vh, 550px); width: auto; aspect-ratio: 9/16; border-radius: 24px; position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: #050505; cursor: pointer; transform-style: preserve-3d; box-shadow: 0 20px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1); transition: border-color 0.4s, box-shadow 0.4s; will-change: transform, opacity; }
    .reel-item:hover { border-color: var(--accent); box-shadow: 0 40px 80px rgba(0,0,0,0.8), 0 0 40px rgba(64,181,229,0.3), inset 0 1px 0 rgba(255,255,255,0.3); z-index: 20; }
    .reel-glare { position: absolute; top: 0; left: 0; width: 200%; height: 200%; background: radial-gradient(circle at center, rgba(255,255,255,0.2) 0%, transparent 50%); mix-blend-mode: overlay; opacity: 0; pointer-events: none; z-index: 4; transform: translate(-50%, -50%); }
    .reel-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.2) 40%, transparent 100%); pointer-events: none; z-index: 2; transition: opacity 0.4s; }
    .reel-item:hover .reel-overlay { opacity: 0.6; }
    .reel-info { position: absolute; bottom: 25px; left: 25px; right: 25px; z-index: 3; pointer-events: none; transform: translateZ(30px); }
    .reel-info h4 { font-family: var(--font-display); font-size: clamp(0.9rem, 1.2vw, 1.1rem); font-weight: 700; text-transform: uppercase; line-height: 1.3; color: #fff; margin-bottom: 8px; text-shadow: 0 2px 10px rgba(0,0,0,0.8);}
    .reel-info span { font-family: var(--font-display); font-weight: 700; font-size: 8px; color: var(--accent); text-transform: uppercase; letter-spacing: 1px; }
    .video-badge { position: absolute; top: 20px; right: 20px; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 6px 12px; display: flex; align-items: center; gap: 6px; z-index: 5; pointer-events: none; transform: translateZ(20px); }
    .video-badge svg { width: 10px; height: 10px; fill: var(--accent); }
    .video-badge span { font-family: var(--font-display); font-size: 7px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 1px; }
    .target-img, .reel-bg { z-index: 1; }
    .hover-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 2; opacity: 0; pointer-events: none; transform: scale(1.05); transition: transform 0.5s; }
    .reel-item:hover .hover-video { transform: scale(1); }
    
    .vault-wrapper, .process-wrapper, .profile-wrapper, .terminal-wrapper { padding: clamp(60px, 8vh, 100px) 5vw; border-top: 1px solid var(--border); }
    .vault-grid, .process-grid, .profile-grid, .terminal-grid { gap: clamp(20px, 3vw, 40px); max-width: 1400px; margin: 0 auto; }
    .section-header { text-align: center; margin-bottom: 60px; }
    .section-header h2 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); text-transform: uppercase; }
    .vault-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
    .v-item { position: relative; height: 280px; border-radius: 12px; overflow: hidden; pointer-events: auto; border: 1px solid var(--border); transition: border 0.5s; transform: translate3d(0,0,0); backface-visibility: hidden; will-change: transform, opacity; cursor: pointer;}
    .v-item::before { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 60%; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%); z-index: 2; pointer-events: none; transition: opacity 0.4s; }
    .v-item:hover::before { opacity: 0.7; }
    .v-info { position: absolute; bottom: 20px; left: 20px; z-index: 3; pointer-events: none;}
