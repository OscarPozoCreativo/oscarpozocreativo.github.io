    .btn-outline { padding: 16px 32px; border: 1px solid var(--border); border-radius: 100px; color: var(--text); font-size: 0.7rem; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1); text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transform: translateZ(0); }
    .btn-outline:hover { background: var(--text); color: #000; border-color: var(--text); transform: translate3d(0, -3px, 0); }
    .btn-solid { background: var(--text); color: #000; border: 1px solid var(--text); }
    .btn-solid:hover { background: transparent; color: var(--text); border-color: var(--border); }
    
    .lightbox { position: fixed; inset: 0; background: #050505; z-index: 1000000; display: none; opacity: 0; align-items: center; justify-content: center; overflow: hidden; will-change: opacity; }
    .lightbox__ambient { position: absolute; inset: -10%; width: 120%; height: 120%; background-size: cover; background-position: center; filter: blur(60px) saturate(150%); opacity: 0; z-index: 0; pointer-events: none; transform: translateZ(0); will-change: opacity, background-image; }
    
    /* =========================================
       NOOMO AGENCY GLASSMORPHISM EFFECT (LIGHTBOX)
       ========================================= */
    .lightbox__dialog { 
        position: relative; z-index: 1; width: 95vw; height: clamp(500px, 85vh, 900px); max-width: 1400px; 
        display: grid; grid-template-columns: 1fr clamp(300px, 30vw, 400px); 
        background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
        backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); 
        border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; overflow: hidden; 
        box-shadow: 0 50px 100px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.1), inset 0 0 20px rgba(255,255,255,0.02); 
        will-change: transform, opacity; 
